---
import FooterPolicy from '../components/FooterPolicy.astro';
import Header from '../components/Header.astro';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  hideChrome?: boolean;
}

const {
  title = "neøflow // Official TikTok Partners — Shop. Creators. Marketing. Tech",
  description = "Infraestrutura descentralizada de tecnologia e inteligência comercial no ecossistema TikTok Partner. Conectamos lojistas, criadores e dados com autonomia.",
  robots = "index, follow",
  hideChrome = false,
} = Astro.props;

// Purificação de URL Canônica conforme SEO.md v2.1.0
// FIXADO: replace(/\/$/) na raiz produzia string vazia — fallback agora correto
const BASE_URL = "https://neotiktok.com";
const rawCanonical = new URL(Astro.url.pathname, Astro.site || BASE_URL).href;
const canonicalURL = rawCanonical === BASE_URL + '/' ? BASE_URL : rawCanonical.replace(/\/$/, '');

// OG Image canônica (social sharing)
const ogImage = `${BASE_URL}/assets/og-cover.png`;

// Schema.org JSON-LD (@graph)
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://neotiktok.com/#organization",
      "name": "neotiktok agency",
      "alternateName": [
        "neøflow",
        "neøflow official tiktok partners",
        "Neo FlowOFF Agency",
        "neotiktok.com"
      ],
      "legalName": "Flowoff Marketing e Assessoria Digital LTDA",
      "url": "https://neotiktok.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://neotiktok.com/assets/logo_partners.svg"
      },
      "description": description,
      "slogan": "Seu perfil. Seus interesses. Nosso negócio.",
      "email": "neo@neotiktok.com",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "BR"
      },
      "knowsAbout": [
        "TikTok Shop Partner",
        "Integração autorizada com TikTok Shop",
        "Consulta de pedidos do TikTok Shop"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://neotiktok.com/#website",
      "url": "https://neotiktok.com",
      "name": "neøflow official tiktok partners",
      "publisher": {
        "@id": "https://neotiktok.com/#organization"
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    <!-- High Priority Preload for LCP Image (Eliminates Resource Load Delay) -->
    <link rel="preload" as="image" href="/assets/logo_partners.svg" type="image/svg+xml" fetchpriority="high" />

    <!-- Mobile & iOS WebApp Meta Tags -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="neøflow" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Canonical URL (SEO.md v2.1.0) -->
    <link rel="canonical" href={canonicalURL} />

    <!-- PWA WebApp Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo_partners.svg" />

    <!-- Google Fonts Optimization (Non-Blocking Preload) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Critical Inline CSS (Instant FCP Paint) -->
    <style is:inline>
      html, body {
        background-color: #0b0b0c;
        color: #ffffff;
        margin: 0;
        padding: 0;
        -webkit-font-smoothing: antialiased;
        -webkit-text-size-adjust: 100%;
        -moz-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }
      .preloader-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background-color: #0b0b0c;
        display: flex;
        align-items: center;
        justify-content: center;
      }
    </style>

    <!-- Meta Open Graph (Desambiguação de Marca) -->
    <meta property="og:site_name" content="neøflow // Official TikTok Partners" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="pt_BR" />
    <!-- FIXADO: og:image era ausente — cards sociais não renderizavam imagem -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="neøflow // Official TikTok Partners" />
    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- TikTok Pixel Code -->
    <script is:inline>
      !function (w, d, t) {
        w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};n=document.createElement("script");n.type="text/javascript",n.async=!0,n.src=r+"?sdkid="+e+"&lib="+t;e=document.getElementsByTagName("script")[0];e.parentNode.insertBefore(n,e)};
        ttq.load('D9SJPC3C77U97D5QGU0G');
        ttq.page();
      }(window, document, 'ttq');
    </script>

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body class={hideChrome ? "pwa-viewport-lock" : ""}>
    {!hideChrome && (
      <>
        <!-- Skip Navigation (Acessibilidade: WCAG 2.4.1) -->
        <a href="#main-content" class="skip-to-content">Pular para o conteúdo principal</a>
        <Header />
      </>
    )}
    <main id="main-content" class={hideChrome ? "pwa-main-canvas" : ""}>
      <slot />
    </main>
    {!hideChrome && <FooterPolicy />}

    <!-- Launch web: remove registros/cache PWA antigos que causavam comportamento divergente entre perfis. -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          void navigator.serviceWorker.getRegistrations()
            .then((registrations) => Promise.all(registrations.map((registration) => registration.unregister())))
            .catch(() => undefined);
        });
      }
      if ('caches' in window) {
        window.addEventListener('load', () => {
          void caches.keys().then((keys) => {
            const legacyKeys = keys.filter((key) => key.startsWith('neoflow-'));
            return Promise.all(legacyKeys.map((key) => caches.delete(key)));
          }).catch(() => undefined);
        });
      }
    </script>
    <style is:inline>
      .skip-to-content {
        position: absolute;
        top: -100%;
        left: 1rem;
        padding: 0.5rem 1rem;
        background: #d7fe09;
        color: #050b0f;
        font-weight: 700;
        font-size: 0.875rem;
        border-radius: 0 0 8px 8px;
        text-decoration: none;
        z-index: 100000;
        transition: top 0.2s;
      }
      .skip-to-content:focus {
        top: 0;
      }
      body.pwa-viewport-lock {
        overflow: hidden !important;
        height: 100vh !important;
        height: 100dvh !important;
        max-height: 100dvh !important;
        width: 100% !important;
        position: fixed !important;
        inset: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        touch-action: manipulation;
        -webkit-overflow-scrolling: auto;
      }
      .pwa-main-canvas {
        height: 100% !important;
        width: 100% !important;
        overflow: hidden !important;
      }
    </style>
  </body>
</html>
