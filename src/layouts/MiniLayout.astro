---
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  role?: 'seller' | 'creator' | 'buyer' | 'common';
  activeTab?: 'home' | 'catalog' | 'wallet' | 'orders';
}

const {
  title = "neøflow // TikTok Minis",
  description = "Mini App nativo de social commerce e automação TikTok.",
  role = 'common',
  activeTab = 'home',
} = Astro.props;

const BASE_URL = "https://neotiktok.com";
const rawCanonical = new URL(Astro.url.pathname, Astro.site || BASE_URL).href;
const canonicalURL = rawCanonical === BASE_URL + '/' ? BASE_URL : rawCanonical.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Mobile & Mini App Specific Tags -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#0b0b0c" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/assets/logo_partners.svg" />

    <!-- Fonts Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <style is:inline>
      * {
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
      }
      html, body {
        background-color: #050608;
        color: #ffffff;
        margin: 0;
        padding: 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        overflow-x: hidden;
      }
    </style>
  </head>
  <body>
    <!-- Desktop Center Wrapper (Emulates 9:16 In-App TikTok WebView) -->
    <div class="minis-viewport-container">
      <div class="minis-device-frame">
        <!-- Top Status & Minis Bar -->
        <header class="minis-top-bar" aria-label="Barra do TikTok Mini App">
          <div class="minis-left-action">
            <button type="button" class="minis-nav-btn" onclick="if(window.history.length > 1){window.history.back();}else{window.location.href='/minis';}" aria-label="Voltar">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
          </div>

          <div class="minis-brand-title">
            <span class="minis-dot"></span>
            <span class="font-mono">neøflow // minis</span>
          </div>

          <div class="minis-right-action">
            <a href="/" class="minis-close-btn" title="Voltar ao portal web">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </a>
          </div>
        </header>

        <!-- Main Mini App Scrollable View -->
        <main class="minis-content-scroll" id="minis-main-view">
          <slot />
        </main>

        <!-- Bottom Minis Nav Bar (Role-Specific) -->
        {role !== 'common' && (
          <nav class="minis-bottom-bar font-mono" aria-label="Navegação do Mini App">
            {role === 'seller' ? (
              <>
                <a href="/minis/seller" class={`minis-tab ${activeTab === 'home' ? 'active' : ''}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                  <span>Início</span>
                </a>
                <a href="/minis/seller/dashboard" class={`minis-tab ${activeTab === 'orders' ? 'active' : ''}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                  <span>Vendas</span>
                </a>
              </>
            ) : (
              <>
                <a href="/minis/creator" class={`minis-tab ${activeTab === 'home' ? 'active' : ''}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                  <span>Hub</span>
                </a>
                <a href="/minis/creator/catalog" class={`minis-tab ${activeTab === 'catalog' ? 'active' : ''}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                  <span>Catálogo</span>
                </a>
                <a href="/minis/creator/wallet" class={`minis-tab ${activeTab === 'wallet' ? 'active' : ''}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                  <span>Carteira</span>
                </a>
              </>
            )}
          </nav>
        )}
      </div>
    </div>
  </body>
</html>

<style>
  .minis-viewport-container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: radial-gradient(circle at 50% 10%, rgba(254, 44, 85, 0.08) 0%, #050608 85%);
    padding: 1.5rem 0;
  }

  .minis-device-frame {
    width: 100%;
    max-width: 420px;
    height: 100vh;
    max-height: 880px;
    background: #0b0b0c;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 36px;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 40px rgba(254, 44, 85, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
  }

  /* Minis Top Bar */
  .minis-top-bar {
    height: 54px;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(11, 11, 12, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(16px);
    z-index: 50;
    flex-shrink: 0;
  }

  .minis-nav-btn, .minis-close-btn {
    background: none;
    border: none;
    color: #ffffff;
    padding: 0.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 50%;
    transition: background 0.2s ease;
  }

  .minis-nav-btn:hover, .minis-close-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .minis-brand-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #ffffff;
  }

  .minis-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--neo-coral);
    box-shadow: 0 0 8px var(--neo-coral);
  }

  /* Scrollable Content */
  .minis-content-scroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    -webkit-overflow-scrolling: touch;
  }

  /* Bottom Navigation */
  .minis-bottom-bar {
    height: 64px;
    background: rgba(11, 11, 12, 0.95);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 0 1rem calc(env(safe-area-inset-bottom, 0px) + 0.25rem);
    z-index: 50;
    flex-shrink: 0;
  }

  .minis-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: color 0.2s ease, transform 0.15s ease;
  }

  .minis-tab:hover, .minis-tab.active {
    color: var(--neo-coral);
  }

  .minis-tab.active svg {
    stroke: var(--neo-coral);
  }

  /* Mobile In-App Native Viewport */
  @media (max-width: 500px) {
    .minis-viewport-container {
      padding: 0;
      background: #0b0b0c;
      min-height: 100vh;
      min-height: 100dvh;
    }

    .minis-device-frame {
      max-width: 100vw;
      height: 100vh;
      height: 100dvh;
      max-height: 100vh;
      max-height: 100dvh;
      border: none;
      border-radius: 0;
      box-shadow: none;
    }

    .minis-top-bar {
      padding-top: env(safe-area-inset-top, 0px);
      height: calc(54px + env(safe-area-inset-top, 0px));
    }
  }
</style>
