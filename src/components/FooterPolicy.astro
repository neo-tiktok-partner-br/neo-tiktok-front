---
const currentYear = new Date().getFullYear();
const contactEmail = "neo@neoflowoff.agency";
---

<footer class="neo-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Coluna 1: Marca, Descrição e Contato -->
      <div class="footer-brand font-display">
        <h3 class="brand-title">
          <span>neøflow</span><span class="footer-slash-coral">/</span><span class="footer-slash-cyan">/</span>
        </h3>
        <p class="brand-tagline font-mono">Official TikTok Partners</p>
        <p class="brand-desc">
          A INFRAESTRUTURA ESTÁ PRONTA.<br />SEJA A PRIMEIRA CAMADA DE OPERADORES.
        </p>
        <p class="contact-info font-mono">
          <a href={`mailto:${contactEmail}`} class="email-link">{contactEmail}</a>
        </p>
      </div>

      <!-- Coluna 2: Links Legais Obrigatórios -->
      <div class="footer-col">
        <h4 class="col-title font-mono">CONFORMIDADE</h4>
        <ul class="footer-links">
          <li><a href="/legal/privacidade">Diretrizes de Privacidade (LGPD)</a></li>
          <li><a href="/legal/termos">Termos de Uso &amp; Serviços</a></li>
        </ul>
      </div>
    </div>

    <!-- Divisor Visual -->
    <div class="footer-divider"></div>

    <!-- Rodapé de Disclaimer Legal e Copyright compactados -->
    <div class="footer-bottom font-mono">
      <p class="legal-notice">
        <strong>Aviso:</strong> A <strong>neøflow</strong> é uma parceira de tecnologia independente do TikTok Shop. As marcas registradas TikTok e TikTok Shop pertencem às suas respectivas detentoras. Em conformidade com a LGPD e o Código de Defesa do Consumidor.
      </p>
      <div class="copyright">
        © {currentYear} neøflow // Official TikTok Partners. Todos os direitos reservados.
        <br />
        Flowoff Marketing e Assessoria Digital LTDA — CNPJ: 43.376.355/0001-92
      </div>
    </div>
  </div>
</footer>

<style>
  .neo-footer {
    background-color: var(--neo-bg-card);
    border-top: 1px solid var(--neo-border);
    padding: 3rem 1.25rem 2rem 1.25rem; /* Mais compacto verticalmente */
    margin-top: 4rem; /* Margem reduzida */
    color: var(--neo-text-muted);
    font-size: 0.85rem;
  }

  .footer-container {
    max-width: 1080px; /* Alinhado ao max-width da home */
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr; /* Layout de 2 colunas no desktop */
    gap: 2.5rem;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr; /* Coluna única no mobile/tablet */
      gap: 2rem;
    }
    .neo-footer {
      padding: 2.5rem 1rem 1.5rem 1rem; /* Mais compacto em telas pequenas */
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .brand-title {
    font-size: 1.5rem; /* Ajustado tamanho no footer */
    font-weight: 800;
    color: var(--neo-white);
    letter-spacing: -0.03em;
    display: inline-flex;
    align-items: center;
  }

  .footer-slash-coral {
    color: var(--neo-coral);
    margin-left: 2px;
  }

  .footer-slash-cyan {
    color: var(--neo-cyan);
  }

  .brand-tagline {
    color: var(--neo-acid);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .brand-desc {
    color: var(--neo-text-muted);
    line-height: 1.5;
    font-size: 0.825rem;
    max-width: 480px;
  }

  .contact-info {
    font-size: 0.8rem;
    margin-top: 0.5rem;
  }

  .email-link {
    color: var(--neo-cyan);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-smooth);
  }

  .email-link:hover {
    color: var(--neo-acid);
  }

  .col-title {
    color: var(--neo-white);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.85rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    color: var(--neo-text-muted);
    text-decoration: none;
    transition: var(--transition-smooth);
    display: inline-flex;
    align-items: center;
    font-size: 0.825rem;
  }

  .footer-links a:hover {
    color: var(--neo-acid);
    transform: translateX(2px);
  }

  .footer-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--neo-border), transparent);
    margin: 2rem 0 1.5rem 0; /* Espaço reduzido */
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--neo-text-muted);
  }

  .legal-notice {
    opacity: 0.8;
  }

  .copyright {
    border-top: 1px solid rgba(255, 255, 255, 0.03);
    padding-top: 0.85rem;
    font-size: 0.7rem;
    opacity: 0.75;
  }
</style>
