---
interface Props {
  activeTab?: 'home' | 'shop' | 'creators' | 'marketing' | 'tech';
}

const { activeTab = 'home' } = Astro.props;

const tabs = [
  {
    id: 'home',
    label: 'Início',
    href: '/',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    id: 'shop',
    label: 'Shop',
    href: '/shop',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  },
  {
    id: 'creators',
    label: 'Creators',
    href: '/creators',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect width="15" height="14" x="1" y="5" rx="2" ry="2"/></svg>`,
  },
  {
    id: 'marketing',
    label: 'Agências',
    href: '/marketing',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
  {
    id: 'tech',
    label: 'Tech',
    href: '/tech',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  },
];
---

<nav class="ios-bottom-bar" aria-label="Navegação principal">
  <div class="ios-tab-list">
    {tabs.map((tab) => (
      <button
        type="button"
        class={`ios-tab-item ${tab.id === activeTab ? 'is-active' : ''}`}
        data-tab-target={tab.id}
        data-href={tab.href}
        aria-label={tab.label}
        aria-selected={tab.id === activeTab ? 'true' : 'false'}
      >
        <span class="ios-tab-icon" set:html={tab.icon} />
        <span class="ios-tab-label font-mono">{tab.label}</span>
      </button>
    ))}
  </div>
</nav>

<style>
  .ios-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background: rgba(11, 11, 13, 0.88);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    padding-top: 0.45rem;
    padding-bottom: max(0.45rem, env(safe-area-inset-bottom, 0px));
  }

  .ios-tab-list {
    display: flex;
    justify-content: space-around;
    align-items: center;
    max-width: 480px;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  .ios-tab-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.45);
    padding: 0.35rem 0.2rem;
    cursor: pointer;
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.18s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.15s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .ios-tab-item:active {
    transform: scale(0.92);
  }

  .ios-tab-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .ios-tab-label {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .ios-tab-item.is-active {
    color: var(--neo-acid, #d7fe09);
  }

  .ios-tab-item.is-active .ios-tab-icon {
    transform: translateY(-1px);
  }

  .ios-tab-item.is-active .ios-tab-label {
    font-weight: 700;
  }

  /* Hover suave apenas para ponteiros finos (desktop) */
  @media (hover: hover) and (pointer: fine) {
    .ios-tab-item:hover:not(.is-active) {
      color: rgba(255, 255, 255, 0.85);
    }
  }
</style>
