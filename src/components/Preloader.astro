---

<div id="neo-preloader" class="preloader-overlay">
  <div class="preloader-content">
    <div class="logo-spinner-container">
      <div class="spinner-ring outer"></div>
      <div class="spinner-ring inner"></div>
      <div class="brand-core">
        <span class="brand-symbol">NEØ</span>
      </div>
    </div>

    <div class="progress-bar-container">
      <div class="progress-bar-fill" id="preloader-progress"></div>
    </div>

    <div class="loading-status font-mono">
      <span class="status-dot"></span>
      <span id="preloader-status-text">INITIALIZING neøflow PROTOCOL...</span>
    </div>
  </div>
</div>

<style>
  .preloader-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--neo-bg);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.6s ease;
  }

  .preloader-overlay.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .preloader-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    max-width: 320px;
    width: 90%;
    text-align: center;
  }

  .logo-spinner-container {
    position: relative;
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spinner-ring {
    position: absolute;
    border-radius: 50%;
    border: 2px solid transparent;
  }

  .spinner-ring.outer {
    width: 90px;
    height: 90px;
    border-top-color: var(--neo-coral); /* Vermelho/Coral */
    border-right-color: rgba(254, 44, 85, 0.15);
    animation: spin 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }

  .spinner-ring.inner {
    width: 68px;
    height: 68px;
    border-bottom-color: var(--neo-cyan); /* Azulado/Ciano */
    border-left-color: rgba(0, 242, 254, 0.15);
    animation: spin-reverse 0.9s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }

  .brand-core {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--neo-bg-card);
    border: 1px solid var(--neo-border);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.15);
  }

  .brand-symbol {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--neo-white); /* Branco */
    letter-spacing: 1px;
  }

  .progress-bar-container {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    overflow: hidden;
  }

  .progress-bar-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--neo-cyan), var(--neo-coral)); /* Degradê Azulado -> Vermelho */
    border-radius: 4px;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.15s ease-out;
    will-change: transform;
  }

  .loading-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--neo-text-muted);
    letter-spacing: 0.08em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--neo-cyan); /* Azulado */
    box-shadow: 0 0 8px var(--neo-cyan);
    animation: pulse-dot 1s ease-in-out infinite alternate;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes spin-reverse {
    0% { transform: rotate(360deg); }
    100% { transform: rotate(0deg); }
  }

  @keyframes pulse-dot {
    from { opacity: 0.4; }
    to { opacity: 1; }
  }
</style>

<script>
  (function initPreloader() {
    const preloader = document.getElementById('neo-preloader');
    const progressBar = document.getElementById('preloader-progress');
    const statusText = document.getElementById('preloader-status-text');

    // Se o preloader não existir no DOM, aborta silenciosamente
    if (!preloader) return;

    // FIXADO: sem timeout máximo — tela travava para sempre se JS falhasse
    const SAFETY_TIMEOUT_MS = 4000;
    let interval: ReturnType<typeof setInterval> | null = null;

    function dismiss() {
      if (interval) {
        clearInterval(interval);
        interval = null;
      }
      if (progressBar) progressBar.style.transform = 'scaleX(1)';
      if (statusText) statusText.textContent = 'neøflow CONNECTED';
      // Aguarda o frame de paint antes de aplicar a transição
      requestAnimationFrame(() => {
        setTimeout(() => {
          if (preloader) { // Ensure preloader is not null before accessing
            preloader.classList.add('hidden');
            // Remove do DOM após transição para liberar memória e paint layers
            setTimeout(() => preloader.remove(), 650);
          }
        }, 350);
      });
    }

    // FIXADO: prefers-reduced-motion — dispensa preloader imediatamente
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      dismiss();
      return;
    }

    // Safety net: nunca deixa o preloader bloqueando por mais de 4s
    const safetyTimer = setTimeout(dismiss, SAFETY_TIMEOUT_MS);

    let progress = 0;
    interval = setInterval(() => {
      progress += Math.floor(Math.random() * 25) + 15;
      if (progress >= 100) {
        clearTimeout(safetyTimer);
        dismiss();
      } else {
        const scale = progress / 100;
        requestAnimationFrame(() => {
          if (progressBar) progressBar.style.transform = `scaleX(${scale})`;
        });
      }
    }, 80);
  })();
</script>
