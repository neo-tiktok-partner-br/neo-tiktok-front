---
import BottomTabBar from './BottomTabBar.astro';
import { PUBLIC_API_BASE_URL } from '../config/api';

type TabId = 'home' | 'shop' | 'creators' | 'partners' | 'marketing' | 'tech';

interface Props {
  activeTab?: TabId;
  interactive?: boolean;
  desktopPreview?: boolean;
}

const { activeTab: rawTab = 'home', interactive = false, desktopPreview = false } = Astro.props;
const activeTab = rawTab === 'marketing' ? 'partners' : rawTab;

const operations = [
  {
    id: 'shop',
    code: '01',
    label: 'SHOP',
    phrase: 'Quero vender no TikTok Shop.',
    accent: 'coral',
    accentColor: 'var(--neo-coral)',
    glowColor: 'rgba(254, 44, 85, 0.24)',
  },
  {
    id: 'creators',
    code: '02',
    label: 'CREATORS',
    phrase: 'Quero criar e transformar conteúdo em receita.',
    accent: 'cyan',
    accentColor: 'var(--neo-cyan)',
    glowColor: 'rgba(0, 242, 254, 0.24)',
  },
  {
    id: 'partners',
    code: '03',
    label: 'PARTNERS',
    phrase: 'Quero conectar negócios, marcas e creators.',
    accent: 'white',
    accentColor: '#ffffff',
    glowColor: 'rgba(255, 255, 255, 0.2)',
  },
  {
    id: 'tech',
    code: '04',
    label: 'TECH',
    phrase: 'Quero construir e integrar tecnologia.',
    accent: 'acid',
    accentColor: 'var(--neo-acid)',
    glowColor: 'rgba(215, 254, 9, 0.24)',
  },
] as const;

const views = [
  {
    id: 'creators', code: '02', eyebrow: 'CREATOR NETWORK', title: 'Menos caminho entre conteúdo e receita.', subtitle: 'Você cria. A gente aproxima produtos, campanhas e oportunidades para o conteúdo continuar sendo o centro.', accent: 'cyan',
    stats: [['Entrada', 'Alliance Creator'], ['Identidade', 'user_type == 1'], ['Modelo', 'Afiliado']],
    features: [
      ['CRIE PRIMEIRO', 'Seu valor está na linguagem e na relação com quem acompanha você. A operação acontece por baixo para o conteúdo continuar no centro.'],
      ['PRODUTOS QUE FAÇAM SENTIDO', 'Aproxime-se de produtos que façam sentido para o seu conteúdo e que você realmente queira apresentar.'],
      ['CAMPANHAS SEM PERDER SUA VOZ', 'Sua linguagem vem antes do formato da campanha. O resultado precisa parecer seu, não uma propaganda emprestada.'],
      ['TRANSFORME ATENÇÃO EM OPORTUNIDADE', 'A atenção que você já conquista entra em uma jornada que pode ser acompanhada e evoluída.'],
    ],
    action: 'Conectar meu perfil Creator',
    href: `${PUBLIC_API_BASE_URL}/oauth/tiktok-creator/authorize`,
    role: 'CREATOR',
  },
  {
    id: 'partners', code: '03', eyebrow: 'AGÊNCIAS & PARTNERS / TAP', title: 'Menos caminho entre quem vende e quem cria.', subtitle: 'Aproximamos sellers, creators e oportunidades para que boas conexões consigam virar operação e negócio.', accent: 'white',
    stats: [['Entrada', 'Partner Auth'], ['Identidade', 'user_type == 3'], ['Categoria', 'TAP Validado']],
    features: [
      ['ENCONTRE ONDE VOCÊ GERA VALOR', 'Nem todo Partner precisa fazer tudo. Entre pelo ponto em que sua experiência, rede ou operação gera mais valor.'],
      ['TRANSFORME CONEXÃO EM OPERAÇÃO', 'Uma boa indicação não precisa terminar numa conversa. Dê continuidade para que os lados avancem juntos.'],
      ['CRESÇA JUNTO COM A REDE', 'Mais conexões relevantes criam mais possibilidades para quem participa da rede.'],
      ['CLAREZA PARA TODOS OS LADOS', 'Papel, oportunidade e colaboração precisam ser compreendidos por quem participa.'],
    ],
    action: 'Conectar Partner Center',
    href: `${PUBLIC_API_BASE_URL}/oauth/tiktok-partner/authorize`,
    role: 'PARTNER',
  },
  {
    id: 'tech', code: '04', eyebrow: 'TECH / NΞØ PROTOCOL', title: 'Menos caminho entre tecnologia e operação.', subtitle: 'Construa integrações para TikTok Shop sem precisar carregar toda a complexidade da plataforma para dentro do seu produto.', accent: 'acid',
    stats: [['SDK', '@neomello/sdk'], ['Segurança', 'AES-256-GCM'], ['Topologia', '5 Módulos']],
    features: [
      ['NÃO COMECE DO ZERO', 'Conexão, identidade e segurança não deveriam consumir o projeto antes da ideia começar a funcionar.'],
      ['INTEGRE SEM ESPALHAR COMPLEXIDADE', 'Seu produto conversa com a operação sem transformar credenciais, regras e dependências da plataforma em responsabilidade de toda a aplicação.'],
      ['AUTOMATIZE O QUE SE REPETE', 'Use tecnologia para reduzir trabalho operacional e deixar pessoas cuidando das decisões que realmente precisam delas.'],
      ['CRESÇA SEM VIRAR UM MONÓLITO', 'Adicione novas capacidades conforme a operação precisa, mantendo responsabilidades separadas e integrações claras.'],
    ],
    action: 'Ver arquitetura técnica',
    href: '/tech',
    role: null,
  },
] as const;

const sellerAdvantages = [
  {
    code: '01',
    title: 'VENDA ONDE A DESCOBERTA ACONTECE',
    copy: 'O TikTok Shop aproxima conteúdo e comércio. Sua operação não precisa começar mandando o público para fora para só depois tentar converter.',
  },
  {
    code: '02',
    title: 'CREATORS COMO DISTRIBUIÇÃO',
    copy: 'Prepare produtos e oportunidades para trabalhar com creators que já fazem parte da dinâmica de descoberta da plataforma.',
  },
  {
    code: '03',
    title: 'CAMPANHAS MAIS PERTO DA OPERAÇÃO',
    copy: 'Conteúdo, campanhas e Shop deixam de funcionar como ilhas separadas. A ideia é aproximar sinal, distribuição e resultado comercial.',
  },
  {
    code: '04',
    title: 'MENOS TRABALHO REPETITIVO',
    copy: 'Integrações e automações existem para absorver tarefas operacionais por baixo, deixando você mais livre para decidir, criar e vender.',
  },
] as const;

const sellerPaths = [
  {
    code: '01',
    label: 'CREATORS',
    copy: 'Coloque seus produtos em circulação por meio de conteúdo e colaboração.',
    href: '/sellers/creators',
    icon: '↗',
  },
  {
    code: '02',
    label: 'CAMPANHAS',
    copy: 'Estruture ações comerciais sem separar mídia da operação.',
    href: '/sellers/campanhas',
    icon: '↗',
  },
  {
    code: '03',
    label: 'CONECTAR',
    copy: 'Autorize sua Shop e dê o primeiro passo para integrar sua operação.',
    href: '/sellers/conectar',
    icon: '→',
  },
] as const;
---

<div class:list={['mobile-public-shell', { 'is-desktop-preview': desktopPreview }]} data-mobile-public-shell data-interactive={interactive ? 'true' : 'false'}>
  {desktopPreview && (
    <aside class="desktop-preview-link font-mono" aria-label="Versão institucional desktop">
      <span>Preview mobile/PWA</span><a href="/home">Abrir desktop institucional →</a>
    </aside>
  )}

  <div class="mobile-device">
    <header class="mobile-topbar">
      <a class="mobile-brand" href="/" aria-label="neøflow — início">
        <img src="/assets/logo_partners.svg" alt="neøflow Official TikTok Partners" width="220" height="50" loading="eager" fetchpriority="high" />
      </a>
    </header>

    <div class="mobile-stage" aria-live="polite">
      <!-- 00 / HOME -->
      <section class:list={['mobile-view', 'home-view', { 'is-active': activeTab === 'home' }]} data-view="home" aria-label="Início">
        <header class="hero-copy">
          <span class="eyebrow font-mono">NEØFLOW // TIKTOK SHOP</span>
          <h1>Escolha sua porta de entrada.</h1>
          <p>Comece pelo que você gosta de fazer.</p>
        </header>

        <div class="operation-grid" aria-label="Portas de entrada">
          {operations.map((operation) => (
            <a
              class={`operation-card accent-${operation.accent}`}
              href={`/#${operation.id}`}
              data-tab-target={operation.id}
              style={`--card-accent: ${operation.accentColor}; --card-glow: ${operation.glowColor};`}
            >
              <div class="card-glow" aria-hidden="true" />
              <div class="card-inner">
                <div class="card-meta font-mono">
                  <span class="card-code">{operation.code} / {operation.label}</span>
                  <span class="card-arrow" aria-hidden="true">↗</span>
                </div>
                <p class="card-phrase">{operation.phrase}</p>
              </div>
            </a>
          ))}
        </div>

        <footer class="micro-footer font-mono">
          <span>FLOWOFF MARKETING E ASSESSORIA DIGITAL LTDA</span>
          <span><a href="/legal/termos">Termos</a> · <a href="/legal/privacidade">Privacidade</a></span>
        </footer>
      </section>

      <!-- 01 / SHOP // SELLERS (Dedicated Redesigned Commercial Experience) -->
      <section class:list={['mobile-view', 'shop-view', { 'is-active': activeTab === 'shop' }]} data-view="shop" aria-label="Shop / Sellers">
        <header class="hero-copy">
          <span class="eyebrow font-mono accent-coral-text">01 // SHOP // SELLERS</span>
          <h1>Menos caminho entre atenção e venda.</h1>
          <p>Conectamos sua operação ao ecossistema TikTok Shop para aproximar produtos, conteúdo, creators e campanhas de onde a compra acontece.</p>
        </header>

        <!-- CTA Principal -->
        <div class="shop-primary-cta-box">
          <a
            class="shop-primary-btn font-mono"
            href="/sellers/conectar"
            data-oauth-role="SELLER"
            data-auth-endpoint={`${PUBLIC_API_BASE_URL}/oauth/tiktok-shop/authorize`}
          >
            <span>CONECTAR MINHA LOJA</span>
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
          <p class="shop-microcopy">Autorização feita pelo TikTok Shop.</p>
        </div>

        <!-- 04 Vantagens Aprovadas -->
        <div class="shop-advantages-flow" aria-label="Vantagens comerciais">
          {sellerAdvantages.map((adv, idx) => (
            <article class={`advantage-card advantage-card-${idx + 1}`}>
              <div class="advantage-header">
                <span class="advantage-num font-mono">{adv.code}</span>
                <h2 class="advantage-title font-mono">{adv.title}</h2>
              </div>
              <p class="advantage-copy">{adv.copy}</p>
            </article>
          ))}
        </div>

        <!-- Aprofundamento Seller -->
        <div class="seller-paths-section" aria-label="Jornada Seller">
          <span class="seller-paths-kicker font-mono">APROFUNDAR OPERAÇÃO</span>
          <div class="seller-paths-list">
            {sellerPaths.map((path) => (
              <a class="seller-path-item" href={path.href}>
                <div class="seller-path-header font-mono">
                  <span class="seller-path-label">{path.label}</span>
                  <span class="seller-path-arrow" aria-hidden="true">{path.icon}</span>
                </div>
                <p class="seller-path-copy">{path.copy}</p>
              </a>
            ))}
          </div>
        </div>

        <footer class="micro-footer font-mono">
          <span>FLOWOFF MARKETING E ASSESSORIA DIGITAL LTDA</span>
          <span><a href="/legal/termos">Termos</a> · <a href="/legal/privacidade">Privacidade</a></span>
        </footer>
      </section>

      <!-- Other Views (Creators, Partners, Tech) -->
      {views.map((view) => (
        <section class:list={['mobile-view', 'detail-view', `accent-${view.accent}`, { 'is-active': activeTab === view.id }]} data-view={view.id} aria-label={view.title}>
          <header class="hero-copy">
            <span class="eyebrow font-mono">{view.code} / {view.eyebrow}</span>
            <h1>{view.title}</h1>
            <p>{view.subtitle}</p>
          </header>

          <div class="signal-card" aria-label={`Resumo de ${view.title}`}>
            <div class="signal-heading">
              <span class="signal-mark font-mono">{view.code}</span>
              <span class="signal-state font-mono">PRONTO PARA DIAGNÓSTICO</span>
            </div>
            <div class="signal-stats">
              {view.stats.map((stat) => <div><span>{stat[0]}</span><strong>{stat[1]}</strong></div>)}
            </div>
          </div>

          <div class="feature-list">
            {view.features.map((feature, index) => (
              <article><span class="feature-index font-mono">0{index + 1}</span><div><h2>{feature[0]}</h2><p>{feature[1]}</p></div></article>
            ))}
          </div>

          <a
            class="primary-action font-mono"
            href={view.href}
            data-oauth-role={view.role}
            data-auth-endpoint={view.href}
          >
            <span>{view.action}</span>
            <span aria-hidden="true">→</span>
          </a>
        </section>
      ))}
    </div>

    <BottomTabBar activeTab={activeTab} />
  </div>
</div>

{interactive && (
  <script is:inline>
    (() => {
      const shell = document.querySelector('[data-mobile-public-shell][data-interactive="true"]');
      if (!shell) return;
      const views = Array.from(shell.querySelectorAll('[data-view]'));
      const tabs = Array.from(shell.querySelectorAll('[data-tab-target]'));
      const cards = Array.from(shell.querySelectorAll('.operation-card, .advantage-card, .seller-path-item'));
      const validTabs = ['home', 'shop', 'creators', 'partners', 'marketing', 'tech'];

      const normalizeTarget = (target) => (target === 'marketing' ? 'partners' : target);

      const switchTab = (rawTarget) => {
        const target = normalizeTarget(rawTarget);
        if (!validTabs.includes(target)) return;
        views.forEach((view) => view.classList.toggle('is-active', view.getAttribute('data-view') === target));
        tabs.forEach((tab) => {
          const tabTarget = normalizeTarget(tab.getAttribute('data-tab-target'));
          const selected = tabTarget === target;
          if (tab.closest('.ios-bottom-bar')) {
            tab.classList.toggle('is-active', selected);
            selected ? tab.setAttribute('aria-current', 'page') : tab.removeAttribute('aria-current');
          }
        });
        history.replaceState(null, '', target === 'home' ? window.location.pathname : `#${target}`);
        shell.querySelector('.mobile-stage')?.scrollTo({ top: 0, behavior: 'instant' });
      };

      tabs.forEach((tab) => tab.addEventListener('click', (event) => {
        const target = tab.getAttribute('data-tab-target');
        if (!target) return;
        event.preventDefault();
        switchTab(target);
      }));

      // Interação de luz/reflexo pontual nos cards
      const hasReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      cards.forEach((card) => {
        const updatePointer = (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--pointer-x', `${x}px`);
          card.style.setProperty('--pointer-y', `${y}px`);
          card.style.setProperty('--card-glow-opacity', '1');

          if (!hasReducedMotion) {
            const tiltX = (((y / rect.height) - 0.5) * -3.5).toFixed(2);
            const tiltY = (((x / rect.width) - 0.5) * 3.5).toFixed(2);
            card.style.setProperty('--tilt-x', `${tiltX}deg`);
            card.style.setProperty('--tilt-y', `${tiltY}deg`);
          }
        };

        const resetPointer = () => {
          card.style.setProperty('--card-glow-opacity', '0');
          if (!hasReducedMotion) {
            card.style.setProperty('--tilt-x', '0deg');
            card.style.setProperty('--tilt-y', '0deg');
          }
        };

        card.addEventListener('pointerenter', updatePointer, { passive: true });
        card.addEventListener('pointermove', updatePointer, { passive: true });
        card.addEventListener('pointerdown', updatePointer, { passive: true });
        card.addEventListener('pointerleave', resetPointer, { passive: true });
        card.addEventListener('pointercancel', resetPointer, { passive: true });
      });

      // OAuth CTAs: intercept click to fetch JSON launchUrl and navigate directly to TikTok domain
      const oauthActions = Array.from(shell.querySelectorAll('[data-oauth-role]'));
      oauthActions.forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const role = btn.getAttribute('data-oauth-role');
          if (!role) return;
          e.preventDefault();
          const labelSpan = btn.querySelector('span:first-child');
          if (labelSpan) labelSpan.textContent = 'CONECTANDO AO TIKTOK...';
          btn.style.pointerEvents = 'none';
          btn.style.opacity = '0.75';

          const authEndpoint = btn.getAttribute('data-auth-endpoint') || btn.getAttribute('href');
          try {
            const res = await fetch(authEndpoint, {
              headers: { Accept: 'application/json' },
            });
            const data = await res.json();
            if (data && data.authorizeUrl) {
              window.location.assign(data.authorizeUrl);
              return;
            }
            window.location.assign(authEndpoint);
          } catch {
            window.location.assign(authEndpoint);
          }
        });
      });

      const hash = window.location.hash.slice(1);
      if (validTabs.includes(hash)) switchTab(hash);
      window.addEventListener('hashchange', () => {
        const nextHash = window.location.hash.slice(1);
        switchTab(validTabs.includes(nextHash) ? nextHash : 'home');
      });
    })();
  </script>
)}

<style>
  .mobile-public-shell {
    --shell-bg: #070809; --shell-panel: rgba(18, 20, 23, 0.88); --shell-panel-strong: #121417;
    --shell-border: rgba(255, 255, 255, 0.08); --shell-muted: #94a3b8; --shell-accent: var(--neo-acid);
    display: none; min-width: 0; background: var(--shell-bg); color: #fff;
  }
  .mobile-public-shell.is-desktop-preview { display: flex; width: 100%; min-height: 100vh; min-height: 100dvh; align-items: center; justify-content: center; overflow: hidden; }
  .mobile-device { position: relative; display: flex; flex-direction: column; width: min(100%, 430px); height: 100vh; height: 100dvh; max-height: 932px; min-width: 0; overflow: hidden; background: var(--shell-bg); }
  .is-desktop-preview .mobile-device { border: 1px solid var(--shell-border); border-radius: 32px; box-shadow: 0 28px 90px rgba(0, 0, 0, 0.75); }
  .desktop-preview-link { position: fixed; top: 1rem; right: 1rem; z-index: 120; display: flex; align-items: center; gap: 0.7rem; padding: 0.45rem 0.75rem; border: 1px solid var(--shell-border); border-radius: 999px; background: rgba(14, 16, 18, 0.92); color: var(--shell-muted); font-size: 0.65rem; backdrop-filter: blur(12px); }
  .desktop-preview-link a { color: var(--neo-acid); text-decoration: none; }

  .mobile-topbar { z-index: 20; flex: 0 0 auto; display: flex; align-items: center; justify-content: flex-start; min-height: 56px; padding: max(0.5rem, env(safe-area-inset-top)) 1rem 0.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.06); background: rgba(7, 8, 9, 0.92); backdrop-filter: blur(18px); }
  .mobile-brand { display: flex; min-width: 0; }
  .mobile-brand img { display: block; width: auto; height: 24px; max-width: 52vw; }

  .mobile-stage { position: relative; flex: 1 1 auto; min-height: 0; min-width: 0; overflow: hidden; }
  .mobile-device :global(.ios-bottom-bar) { position: relative; flex: 0 0 auto; }
  .mobile-view { position: absolute; inset: 0; display: none; min-width: 0; overflow-x: clip; overflow-y: auto; overscroll-behavior: contain; padding: clamp(1rem, 3.2vh, 1.6rem) 1rem calc(1rem + env(safe-area-inset-bottom)); scrollbar-width: none; }
  .mobile-view::-webkit-scrollbar { display: none; }
  .mobile-view.is-active { display: flex; flex-direction: column; }
  .hero-copy { flex: 0 0 auto; }
  .eyebrow { display: block; margin-bottom: 0.45rem; color: var(--shell-accent); font-size: 0.62rem; font-weight: 600; letter-spacing: 0.14em; }
  .hero-copy h1 { max-width: 360px; margin: 0; font-size: clamp(2.35rem, 10.5vw, 3.15rem); line-height: 0.94; letter-spacing: -0.055em; }
  .hero-copy p { max-width: 330px; margin: 0.55rem 0 0; color: var(--shell-muted); font-size: clamp(0.82rem, 3.4vw, 0.98rem); line-height: 1.35; }

  /* Home Operation Grid & Physical Door Cards */
  .operation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.6rem, 1.8vh, 0.85rem);
    flex: 1 1 auto;
    min-height: 0;
    margin: clamp(0.9rem, 2.4vh, 1.4rem) 0 0.8rem;
    perspective: 1000px;
  }

  .operation-card {
    --card-accent: #ffffff;
    --card-glow: rgba(255, 255, 255, 0.18);
    --card-glow-opacity: 0;
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --pointer-x: 50%;
    --pointer-y: 50%;
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    border-radius: 20px;
    background: linear-gradient(155deg, rgba(22, 24, 27, 0.85) 0%, rgba(10, 11, 13, 0.94) 100%);
    color: #fff;
    text-decoration: none;
    overflow: hidden;
    touch-action: manipulation;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      0 12px 28px -4px rgba(0, 0, 0, 0.55);
    transform: perspective(800px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .operation-card:hover {
    border-color: color-mix(in srgb, var(--card-accent) 45%, rgba(255, 255, 255, 0.12));
    border-top-color: color-mix(in srgb, var(--card-accent) 70%, rgba(255, 255, 255, 0.25));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 18px 36px -6px rgba(0, 0, 0, 0.7),
      0 0 20px -4px var(--card-glow);
  }

  .operation-card:active {
    transform: scale(0.975);
  }

  .card-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(170px circle at var(--pointer-x) var(--pointer-y), var(--card-glow) 0%, transparent 75%);
    opacity: var(--card-glow-opacity);
    transition: opacity 0.25s ease;
    mix-blend-mode: screen;
  }

  .card-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: clamp(0.85rem, 2.2vh, 1.15rem);
    min-height: 0;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    color: var(--card-accent);
  }

  .card-code {
    font-size: clamp(0.58rem, 2.4vw, 0.66rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(0.75rem, 3vw, 0.92rem);
    line-height: 1;
    opacity: 0.7;
    transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s ease;
  }

  .operation-card:hover .card-arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .card-phrase {
    margin-top: auto;
