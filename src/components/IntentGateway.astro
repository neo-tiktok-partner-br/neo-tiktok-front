---
const territories = [
  {
    code: '01',
    label: 'Shop',
    question: 'Quero vender produtos.',
    detail: 'Operação, catálogo, Affiliate e performance para sellers e marcas.',
    href: '/shop',
    accent: 'var(--neo-coral)',
  },
  {
    code: '02',
    label: 'Creators',
    question: 'Quero monetizar meu conteúdo.',
    detail: 'Produtos, colaboração, vídeo e LIVE para creators.',
    href: '/creators',
    accent: 'var(--neo-cyan)',
  },
  {
    code: '03',
    label: 'Marketing',
    question: 'Quero escalar performance.',
    detail: 'Inteligência criativa, campanhas, Shop Ads e mensuração.',
    href: '/marketing',
    accent: 'var(--neo-white)',
  },
  {
    code: '04',
    label: 'Tech',
    question: 'Quero integrar tecnologia.',
    detail: 'Aplicações, OAuth, APIs, webhooks e automações.',
    href: '/tech',
    accent: 'var(--neo-acid)',
  },
];
---

<section class="intent-section" aria-labelledby="intent-title">
  <div class="intent-container">
    <header class="intent-header">
      <p class="intent-kicker font-mono">ESCOLHA SUA ENTRADA</p>
      <h2 id="intent-title" class="font-display">O que você quer construir?</h2>
      <p>
        Comece pela sua intenção. A autorização certa aparece somente quando a
        jornada realmente precisar dela.
      </p>
    </header>

    <div class="intent-grid">
      {territories.map((territory) => (
        <a
          class="intent-card"
          href={territory.href}
          style={`--card-accent: ${territory.accent}`}
          aria-label={`${territory.question} Conhecer ${territory.label}.`}
        >
          <div class="card-meta font-mono">
            <span>{territory.code}</span>
            <span>{territory.label}</span>
          </div>
          <h3 class="font-display">{territory.question}</h3>
          <p>{territory.detail}</p>
          <span class="card-action font-mono" aria-hidden="true">
            EXPLORAR <span>↗</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .intent-section {
    padding: 6rem 1.25rem;
    background:
      radial-gradient(circle at 50% 0%, rgba(215, 254, 9, 0.07), transparent 32rem),
      var(--neo-bg);
  }

  .intent-container {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
  }

  .intent-header {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  .intent-kicker {
    color: var(--neo-acid);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    margin-bottom: 1rem;
  }

  .intent-header h2 {
    font-size: clamp(2.25rem, 7vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    margin-bottom: 1.25rem;
  }

  .intent-header > p:last-child {
    max-width: 620px;
    color: var(--neo-text-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }

  .intent-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .intent-card {
    min-height: 290px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    color: var(--neo-white);
    text-decoration: none;
    background: var(--neo-bg-card);
    border: 1px solid var(--neo-border);
    border-radius: var(--radius-ios);
    box-shadow: var(--shadow-ios);
    overflow: hidden;
    position: relative;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .intent-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--card-accent);
  }

  .intent-card:hover,
  .intent-card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--card-accent);
    background: rgba(25, 25, 28, 0.92);
    outline: none;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    color: var(--card-accent);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .intent-card h3 {
    max-width: 420px;
    margin-top: auto;
    font-size: clamp(1.65rem, 4vw, 2.4rem);
    line-height: 1.02;
  }

  .intent-card p {
    color: var(--neo-text-muted);
    margin: 0.8rem 0 1.5rem;
    max-width: 440px;
  }

  .card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--neo-border);
    color: var(--card-accent);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  @media (max-width: 720px) {
    .intent-section {
      padding: 4.5rem 1rem;
    }

    .intent-grid {
      grid-template-columns: 1fr;
    }

    .intent-card {
      min-height: 250px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intent-card {
      transition: none;
    }

    .intent-card:hover,
    .intent-card:focus-visible {
      transform: none;
    }
  }
</style>
