---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Paulinha // IA que aproxima produtos e pessoas';
const pageDescription = 'Conheça Paulinha, creator brasileira gerada por IA para ligar lojistas, marcas e compradores por meio de conteúdo comercial transparente e dirigido por pessoas.';
const steps = [
  ['01', 'Briefing', 'Produto, público e materiais autorizados.'],
  ['02', 'Criação', 'Narrativa e cenas com direção humana.'],
  ['03', 'Revisão', 'Identidade, claims e disclosures conferidos.'],
  ['04', 'Entrega', 'Conteúdo adaptado ao canal aprovado.'],
];
const faqs = [
  ['Paulinha é uma pessoa real?', 'Não. Paulinha é uma creator/personagem brasileira gerada por inteligência artificial, com direção criativa humana.'],
  ['Ela usou ou testou os produtos?', 'Não se presume experiência física. Sem prova atribuível, o conteúdo é uma representação visual baseada em materiais autorizados.'],
  ['Como funciona uma parceria?', 'Começamos pelo produto, público e objetivo. Depois definimos a narrativa, produzimos as peças e submetemos claims e disclosures à revisão.'],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <article class="page">
    <!-- 1. HERO: APRESENTAÇÃO, HEADLINE & PROPOSTA -->
    <section class="hero" aria-labelledby="page-title">
      <div class="glow" aria-hidden="true"></div>
      <div class="shell hero-container">
        <div class="hero-copy">
          <p class="signal font-mono"><i></i> CREATOR COMMERCE · IA + DIREÇÃO HUMANA</p>
          <div class="paulinha-mark">
            <img src="/assets/paulinha-logo.png" alt="Paulinha" width="900" height="380" decoding="async" fetchpriority="high" />
          </div>
          <h1 id="page-title" class="lead">
            Uma inteligência artificial como ferramenta real de ligação entre <strong>quem vende</strong> e <strong>quem quer comprar melhor.</strong>
          </h1>
          <p class="note">
            Creator brasileira gerada por IA. Estratégia, direção criativa e revisão continuam 100% humanas.
          </p>
          <div class="actions">
            <a class="button primary" href="mailto:neo@neotiktok.com?subject=Parceria%20com%20a%20Paulinha">
              Propor uma parceria <span aria-hidden="true">↗</span>
            </a>
            <a class="button secondary" href="#perfil">
              Ver perfil no TikTok <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. PERFIL OFICIAL: EMBED DO TIKTOK DESTACADO -->
    <section class="profile-section" id="perfil" aria-labelledby="profile-title">
      <div class="shell">
        <div class="profile-frame">
          <div class="profile-intro">
            <p class="signal font-mono"><i></i> PRESENÇA OFICIAL</p>
            <h2 id="profile-title">Acompanhe a Paulinha na prática.</h2>
            <p class="profile-desc">Vídeos curtos, reviews contextuais e conteúdo voltado para o comércio de descoberta no TikTok.</p>
          </div>
          <div class="profile-card">
            <div class="profile-card-header">
              <span class="font-mono">TIKTOK CREATOR · @paulinhaazevedomendes</span>
              <span class="live-indicator"><i></i> ATIVO</span>
            </div>
            <div class="tiktok-wrapper">
              <blockquote class="tiktok-embed" cite="https://www.tiktok.com/@paulinhaazevedomendes" data-unique-id="paulinhaazevedomendes" data-embed-type="creator" style="max-width:780px;min-width:288px">
                <section><a target="_blank" rel="noopener noreferrer" href="https://www.tiktok.com/@paulinhaazevedomendes?refer=creator_embed">@paulinhaazevedomendes</a></section>
              </blockquote>
              <script async src="https://www.tiktok.com/embed.js"></script>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. EDITORIAL & PROPOSTA DE VALOR (BENTO GRID) -->
    <section class="editorial" id="proposta" aria-labelledby="proposal-title">
      <div class="shell">
        <header class="section-head">
          <p class="signal font-mono"><i></i> A PROPOSTA</p>
          <h2 id="proposal-title">Conteúdo que cria uma ponte, não mais ruído.</h2>
          <p>Paulinha transforma informação comercial em histórias curtas, compreensíveis e revisáveis — sem substituir o julgamento de marcas, lojistas ou compradores.</p>
        </header>
        <div class="bento">
          <article class="card seller">
            <p class="label font-mono">PARA QUEM VENDE</p>
            <h3>Produto com contexto.</h3>
            <p>Uma forma consistente de traduzir diferenciais, usos possíveis e informações autorizadas em conteúdo mais próximo das pessoas.</p>
            <span class="index font-mono">01</span>
          </article>
          <article class="card buyer">
            <p class="label font-mono">PARA QUEM COMPRA</p>
            <h3>Clareza antes do clique.</h3>
            <p>Conteúdo direto, identificado quando comercial e sem fingir uma experiência que não aconteceu.</p>
            <span class="index font-mono">02</span>
          </article>
          <article class="card thesis">
            <p class="label font-mono">NOSSA TESE</p>
            <blockquote>IA não ocupa o lugar da confiança. Ela ajuda a construir a ligação.</blockquote>
            <p>Automação amplia possibilidades; controle humano preserva intenção e responsabilidade.</p>
          </article>
          <article class="card process">
            <div class="process-head">
              <p class="label font-mono">COMO A IDEIA GANHA FORMA</p>
              <span class="font-mono">04 ETAPAS</span>
            </div>
            <ol>
              {steps.map(([number, title, text]) => (
                <li>
                  <span class="number font-mono">{number}</span>
                  <div>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </article>
          <article class="card fit">
            <p class="label font-mono">PARCERIA SÉRIA É</p>
            <ul>
              <li>produto e origem verificáveis</li>
              <li>claims que possam ser sustentados</li>
              <li>transparência sobre publicidade e IA</li>
              <li>objetivo claro para cada conteúdo</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 4. TRANSPARÊNCIA & FAQ -->
    <section class="trust" aria-labelledby="trust-title">
      <div class="shell trust-grid">
        <div>
          <p class="signal font-mono"><i></i> TRANSPARÊNCIA PRIMEIRO</p>
          <h2 id="trust-title">A tecnologia aparece.<br />A responsabilidade também.</h2>
          <p class="trust-copy">Paulinha não é uma pessoa humana. Sua imagem e seus conteúdos são produzidos com IA e direção humana. Publicidade, parceria paga ou afiliação devem ser identificadas quando aplicáveis.</p>
          <div class="tags">
            <span>IA DECLARADA</span>
            <span>DIREÇÃO HUMANA</span>
            <span>CLAIMS REVISADOS</span>
          </div>
        </div>
        <div class="faq">
          {faqs.map(([question, answer], index) => (
            <details open={index === 0}>
              <summary>
                {question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. CTA FINAL -->
    <section class="final" aria-labelledby="cta-title">
      <div class="shell final-grid">
        <div>
          <p class="label font-mono">MARCAS // SELLERS // PROJETOS</p>
          <h2 id="cta-title">Se existe afinidade real, vamos conversar.</h2>
        </div>
        <a class="button dark" href="mailto:neo@neotiktok.com?subject=Parceria%20com%20a%20Paulinha">
          Apresentar uma proposta <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .page {
    background: #f4f2ed;
    color: var(--neo-text-dark);
    overflow-x: hidden;
  }

  .shell {
    width: min(1160px, calc(100% - 2.5rem));
    margin-inline: auto;
  }

  /* 1. HERO */
  .hero {
    position: relative;
    padding: calc(6.5rem + var(--sat)) 0 4rem;
    overflow: clip;
    background: #f4f2ed;
  }

  .glow {
    position: absolute;
    inset: 5% auto auto 15%;
    width: min(75vw, 680px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.14), rgba(215, 254, 9, 0.08) 45%, transparent 70%);
    filter: blur(48px);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    max-width: 860px;
  }

  .signal {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #087c82;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .signal i,
  .live-indicator i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--neo-acid);
    box-shadow: 0 0 14px rgba(155, 181, 0, 0.6);
  }

  .paulinha-mark {
    width: min(100%, 480px);
    margin: 1.2rem 0 1.4rem;
    line-height: 0;
  }

  .paulinha-mark img {
    display: block;
    width: 100%;
    height: auto;
    filter: invert(1);
    mix-blend-mode: multiply;
  }

  .lead {
    font: 500 clamp(1.65rem, 4vw, 2.75rem)/1.15 var(--font-display);
    letter-spacing: -0.04em;
    color: #1a2023;
  }

  .lead strong {
    color: #087c82;
    font-weight: 600;
  }

  .note {
    max-width: 620px;
    margin-top: 1.4rem;
    color: #526067;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 2.2rem;
  }

  .button {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border-radius: var(--radius-full);
    padding: 0.85rem 1.4rem;
    font: 700 0.76rem var(--font-mono);
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .button.primary {
    background: var(--neo-text-dark);
    color: var(--neo-white);
  }

  .button.primary:hover {
    background: var(--neo-coral);
    transform: translateY(-2px);
  }

  .button.secondary {
    background: rgba(255, 255, 255, 0.8);
    color: var(--neo-text-dark);
    border: 1px solid rgba(5, 11, 15, 0.18);
    backdrop-filter: blur(12px);
  }

  .button.secondary:hover {
    background: #fff;
    transform: translateY(-2px);
  }

  /* 2. PROFILE SECTION (EMBED) */
  .profile-section {
    padding: 2rem 0 4.5rem;
    background: #f4f2ed;
  }

  .profile-frame {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.5));
    box-shadow: 0 20px 60px rgba(38, 48, 52, 0.08);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .profile-intro h2 {
    margin: 0.8rem 0 1rem;
    font: 700 clamp(1.8rem, 3.2vw, 2.75rem)/1.05 var(--font-display);
    letter-spacing: -0.04em;
  }

  .profile-desc {
    color: #526067;
    font-size: 1rem;
    line-height: 1.6;
  }

  .profile-card {
    border: 1px solid rgba(5, 11, 15, 0.1);
    border-radius: var(--radius-md);
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.06);
  }

  .profile-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: #0b0b0c;
    color: var(--neo-cyan);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .live-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--neo-white);
  }

  .tiktok-wrapper {
    padding: 0.5rem;
    display: flex;
    justify-content: center;
    background: #fafaf8;
  }

  .tiktok-wrapper .tiktok-embed {
    width: 100% !important;
    margin: 0 !important;
  }

  /* 3. EDITORIAL & BENTO GRID */
  .editorial {
    padding: clamp(4rem, 7vw, 6.5rem) 0;
    background: var(--neo-white);
    color: var(--neo-text-dark);
  }

  .section-head {
    display: grid;
    grid-template-columns: 0.7fr 1.4fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 2.75rem;
  }

  .section-head h2,
  .trust h2,
  .final h2 {
    font: 700 clamp(2.2rem, 4.5vw, 4.5rem)/0.94 var(--font-display);
    letter-spacing: -0.06em;
  }

  .section-head > p:last-child {
    color: #46565d;
    line-height: 1.6;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-flow: dense;
    gap: 0.85rem;
  }

  .card {
    position: relative;
    min-height: 230px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: var(--radius-md);
    padding: clamp(1.4rem, 2.5vw, 2rem);
    background: rgba(244, 244, 241, 0.7);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85), 0 12px 35px rgba(38, 48, 52, 0.07);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .card h3 {
    font: 650 clamp(1.6rem, 2.8vw, 2.5rem)/0.96 var(--font-display);
    letter-spacing: -0.045em;
  }

  .card > p:not(.label) {
    max-width: 580px;
    margin-top: 1rem;
    color: #46565d;
    line-height: 1.55;
  }

  .label {
    margin-bottom: auto;
    color: #526067;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .index {
    position: absolute;
    right: 1.25rem;
    top: 1.25rem;
    color: #7a858a;
    font-size: 0.68rem;
  }

  .seller {
    grid-column: span 7;
    min-height: 310px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: rgba(11, 11, 12, 0.94);
    color: white;
    box-shadow: inset 1px 0 rgba(0, 242, 254, 0.22), inset -1px 0 rgba(254, 44, 85, 0.18), 0 16px 42px rgba(11, 11, 12, 0.16);
  }

  .seller .label { color: var(--neo-cyan); }
  .seller > p:not(.label) { color: var(--neo-text-muted); }

  .buyer {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: rgba(0, 242, 254, 0.8);
  }

  .buyer .label,
  .buyer > p:not(.label) { color: #12363b; }

  .thesis {
    grid-column: span 5;
    min-height: 350px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(215, 254, 9, 0.85);
  }

  .thesis blockquote {
    margin: 2rem 0 1.25rem;
    font: 650 clamp(1.8rem, 3.5vw, 3.2rem)/0.96 var(--font-display);
    letter-spacing: -0.05em;
  }

  .thesis > p:not(.label) { color: #263000; }

  .process {
    grid-column: span 7;
    background: rgba(235, 236, 231, 0.75);
  }

  .process-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(5, 11, 15, 0.13);
    padding-bottom: 0.9rem;
  }

  .process ol {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1.5rem;
  }

  .process li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 0.6rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid rgba(5, 11, 15, 0.13);
  }

  .number {
    color: #087c82;
    font-size: 0.65rem;
    padding-top: 0.15rem;
    font-weight: 700;
  }

  .process li h3 { font-size: 0.98rem; }
  .process li p {
    margin-top: 0.2rem;
    color: #526067;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .fit {
    grid-column: span 12;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    background: rgba(254, 44, 85, 0.92);
    color: white;
  }

  .fit .label { color: white; }
  .fit ul {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1.5rem;
  }

  .fit li {
    position: relative;
    padding-left: 1.1rem;
    font: 600 1rem/1.35 var(--font-display);
  }

  .fit li:before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.47em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
  }

  /* 4. TRUST & FAQ */
  .trust {
    padding: clamp(4rem, 7vw, 6.5rem) 0;
    border-bottom: 1px solid var(--neo-border);
    background: var(--neo-bg);
    color: var(--neo-white);
  }

  .trust .signal { color: var(--neo-cyan); }
  .trust-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .trust h2 { margin: 1.2rem 0 1.4rem; }
  .trust-copy {
    max-width: 650px;
    color: var(--neo-text-muted);
    line-height: 1.65;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.6rem;
  }

  .tags span {
    border: 1px solid var(--neo-border);
    border-radius: var(--radius-full);
    padding: 0.45rem 0.75rem;
    color: var(--neo-text-muted);
    font: 0.62rem var(--font-mono);
    letter-spacing: 0.08em;
  }

  .faq { border-top: 1px solid var(--neo-border); }
  details { border-bottom: 1px solid var(--neo-border); }
  summary {
    min-height: 56px;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0;
    font: 600 1.05rem var(--font-display);
  }

  summary::-webkit-details-marker { display: none; }
  summary span {
    color: var(--neo-cyan);
    font-family: var(--font-mono);
  }

  details p {
    padding: 0 1.5rem 1.25rem 0;
    color: var(--neo-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* 5. FINAL */
  .final {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    background: var(--neo-acid);
    color: var(--neo-text-dark);
  }

  .final-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
  }

  .final h2 {
    max-width: 840px;
    margin-top: 0.8rem;
  }

  .dark {
    background: var(--neo-text-dark);
    color: white;
    white-space: nowrap;
  }

  .dark:hover {
    background: white;
    color: var(--neo-text-dark);
    transform: translateY(-2px);
  }

  :global(#site-header:not(.is-scrolled) .header-logo) { color: var(--neo-text-dark); }
  :global(#site-header:not(.is-scrolled) .menu-toggle) {
    color: var(--neo-text-dark);
    border-color: rgba(5, 11, 15, 0.16);
    background: rgba(255, 255, 255, 0.5);
  }

  /* RESPONSIVIDADE MOBILE (COM MARGENS CONFORTÁVEIS) */
  @media (max-width: 768px) {
    .shell {
      width: calc(100% - 2.5rem); /* Margem lateral generosa de 20px */
    }

    .hero {
      padding: calc(5.5rem + var(--sat)) 0 3rem;
    }

    .paulinha-mark {
      width: 72%;
      max-width: 320px;
      margin: 0.8rem 0 1rem;
    }

    .lead {
      font-size: clamp(1.45rem, 6.5vw, 1.85rem);
      line-height: 1.2;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .button {
      width: 100%;
    }

    .profile-section {
      padding: 1.5rem 0 3.5rem;
    }

    .profile-frame {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 1.4rem;
    }

    .section-head,
    .trust-grid,
    .final-grid {
      grid-template-columns: 1fr;
    }

    .section-head {
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .section-head h2,
    .trust h2,
    .final h2 {
      font-size: clamp(2rem, 9.5vw, 3rem);
    }

    .bento {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .card {
      grid-column: span 1 !important;
      min-height: auto;
      padding: 1.35rem;
    }

    .seller, .buyer, .thesis {
      min-height: 240px;
    }

    .process ol {
      grid-template-columns: 1fr;
    }

    .fit {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .fit ul {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .trust-grid {
      gap: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button { transition: none; }
  }
</style>
