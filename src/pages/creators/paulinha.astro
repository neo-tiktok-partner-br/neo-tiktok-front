---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Paulinha // IA que aproxima produtos e pessoas';
const pageDescription = 'Conheça Paulinha, creator brasileira gerada por IA para ligar lojistas, marcas e compradores por meio de conteúdo comercial transparente e dirigido por pessoas.';

const whatsappPartnerUrl = 'https://wa.me/5562982744565?text=Ol%C3%A1%2C%20quero%20propor%20uma%20parceria%20com%20a%20Paulinha%20no%20TikTok.';

const steps = [
  ['01', 'Briefing', 'Produto, público e materiais autorizados.'],
  ['02', 'Criação', 'Narrativa e cenas com direção humana.'],
  ['03', 'Revisão', 'Identidade, claims e disclosures conferidos.'],
  ['04', 'Entrega', 'Conteúdo adaptado ao canal aprovado.'],
];

const faqs = [
  ['Paulinha é uma pessoa real?', 'Não. Paulinha é uma creator/personagem brasileira gerada por inteligência artificial, com direção criativa humana.'],
  ['Ela usou ou testou os produtos?', 'Não se presume experiência física. Sem prova atribuível, o conteúdo é uma representação visual baseada em materiais autorizados.'],
  ['Como funciona uma parceria?', 'Começamos pelo produto, público e objetivo no WhatsApp. Depois definimos a narrativa, produzimos as peças e submetemos claims e disclosures à revisão.'],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <article class="page">
    <!-- 1. HERO COM GRID LADO A LADO (DESKTOP) E HIERARQUIA PERFEITA (MOBILE) -->
    <section class="hero" aria-labelledby="page-title">
      <div class="glow" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="signal font-mono"><i></i> CREATOR COMMERCE // IA + DIREÇÃO HUMANA</p>
          <div class="paulinha-mark">
            <img 
              src="/assets/paulinha-logo.png" 
              alt="Paulinha" 
              width="900" 
              height="380" 
              decoding="async" 
              fetchpriority="high" 
            />
          </div>
          <h1 id="page-title" class="lead">
            Uma inteligência artificial como ferramenta real de ligação entre <strong>quem vende</strong> e <strong>quem quer comprar melhor.</strong>
          </h1>
          <p class="note">
            Creator brasileira gerada por IA. Estratégia, direção criativa e revisão continuam humanas.
          </p>
          <div class="actions">
            <a 
              class="button light js-whatsapp-partner" 
              href={whatsappPartnerUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Propor uma parceria com a Paulinha pelo WhatsApp"
            >
              Propor uma parceria <span aria-hidden="true">↗</span>
            </a>
            <a class="learn" href="#proposta">
              Entender a proposta <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <aside class="profile" aria-label="Perfil oficial da Paulinha no TikTok">
          <div class="profile-head">
            <span class="font-mono">PERFIL OFICIAL</span>
            <i></i>
          </div>
          <div class="tiktok-wrapper">
            <blockquote 
              class="tiktok-embed" 
              cite="https://www.tiktok.com/@paulinhaazevedomendes" 
              data-unique-id="paulinhaazevedomendes" 
              data-embed-type="creator" 
              style="max-width:780px;min-width:280px"
            >
              <section>
                <a target="_blank" rel="noopener noreferrer" href="https://www.tiktok.com/@paulinhaazevedomendes?refer=creator_embed">
                  @paulinhaazevedomendes
                </a>
              </section>
            </blockquote>
            <script is:inline async src="https://www.tiktok.com/embed.js"></script>
          </div>
        </aside>
      </div>
    </section>

    <!-- 2. EDITORIAL & BENTO GRID -->
    <section class="editorial" id="proposta" aria-labelledby="proposal-title">
      <div class="shell">
        <header class="section-head">
          <p class="signal font-mono"><i></i> A PROPOSTA</p>
          <h2 id="proposal-title">Conteúdo que cria uma ponte, não mais ruído.</h2>
          <p>Paulinha transforma informação comercial em histórias curtas, compreensíveis e revisáveis — sem substituir o julgamento de marcas, lojistas ou compradores.</p>
        </header>
        <div class="bento">
          <article class="card seller">
            <p class="label font-mono">PARA QUEM VENDE</p>
            <h3>Produto com contexto.</h3>
            <p>Uma forma consistente de traduzir diferenciais, usos possíveis e informações autorizadas em conteúdo mais próximo das pessoas.</p>
            <span class="index font-mono">01</span>
          </article>
          <article class="card buyer">
            <p class="label font-mono">PARA QUEM COMPRA</p>
            <h3>Clareza antes do clique.</h3>
            <p>Conteúdo direto, identificado quando comercial e sem fingir uma experiência que não aconteceu.</p>
            <span class="index font-mono">02</span>
          </article>
          <article class="card thesis">
            <p class="label font-mono">NOSSA TESE</p>
            <blockquote>IA não ocupa o lugar da confiança. Ela ajuda a construir a ligação.</blockquote>
            <p>Automação amplia possibilidades; controle humano preserva intenção e responsabilidade.</p>
          </article>
          <article class="card process">
            <div class="process-head">
              <p class="label font-mono">COMO A IDEIA GANHA FORMA</p>
              <span class="font-mono">04 ETAPAS</span>
            </div>
            <ol>
              {steps.map(([number, title, text]) => (
                <li>
                  <span class="number font-mono">{number}</span>
                  <div>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </article>
          <article class="card fit">
            <p class="label font-mono">PARCERIA SÉRIA É</p>
            <ul>
              <li>produto e origem verificáveis</li>
              <li>claims que possam ser sustentados</li>
              <li>transparência sobre publicidade e IA</li>
              <li>objetivo claro para cada conteúdo</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- VITRINE DE PRODUTOS // AFILIADOS -->
    <section class="products-showcase-section" id="vitrine" aria-labelledby="showcase-title">
      <div class="shell">
        <header class="section-head">
          <p class="signal font-mono"><i></i> VITRINE // TIKTOK SHOP AFILIADOS</p>
          <h2 id="showcase-title">Produtos Selecionados pela Paulinha</h2>
          <p>Curadoria com links de afiliados diretos para o TikTok Shop. Ofertas com frete grátis e desconto verificado.</p>
        </header>

        <div class="showcase-grid">
          <article class="showcase-card">
            <div class="showcase-img-wrap">
              <span class="badge-off font-mono">-40% OFF</span>
              <img
                src="/assets/creators/paulinha/garrafa-termica/paulinha-garrafa-rosa-detalhe.png"
                alt="Garrafa Térmica Brilhante com Base em Silicone"
                loading="lazy"
                width="360"
                height="460"
              />
            </div>
            <div class="showcase-card-info">
              <div class="showcase-seller font-mono">
                <span class="dot-green"></span> Vendido por <strong>Vibe da Garrafa</strong>
              </div>
              <h3>Garrafa de Água Térmica Brilhante com Base em Silicone, Tampa Antivazamento e Alça</h3>
              <div class="showcase-rating font-mono">
                ★ 4.8 <span>(5.1k avaliações • 24.3k vendidos)</span>
              </div>
              <div class="showcase-price-row">
                <span class="current-p">R$ 42,90</span>
                <span class="original-p font-mono">R$ 71,20</span>
              </div>
              <div class="showcase-actions">
                <a href="/creators/paulinha/garrafa-termica-brilhante" class="btn-card-details font-mono">
                  VER PÁGINA DO PRODUTO →
                </a>
                <a
                  href="https://vt.tiktok.com/ZS9Bq3aQemhum-m31ZJ/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-card-tiktok font-mono"
                >
                  TIKTOK SHOP ↗
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 3. TRANSPARÊNCIA & FAQ -->
    <section class="trust" aria-labelledby="trust-title">
      <div class="shell trust-grid">
        <div>
          <p class="signal font-mono"><i></i> TRANSPARÊNCIA PRIMEIRO</p>
          <h2 id="trust-title">A tecnologia aparece.<br />A responsabilidade também.</h2>
          <p class="trust-copy">Paulinha não é uma pessoa humana. Sua imagem e seus conteúdos são produzidos com IA e direção humana. Publicidade, parceria paga ou afiliação devem ser identificadas quando aplicáveis.</p>
          <div class="tags">
            <span>IA DECLARADA</span>
            <span>DIREÇÃO HUMANA</span>
            <span>CLAIMS REVISADOS</span>
          </div>
        </div>
        <div class="faq">
          {faqs.map(([question, answer], index) => (
            <details open={index === 0}>
              <summary>
                {question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. CTA FINAL -->
    <section class="final" aria-labelledby="cta-title">
      <div class="shell final-grid">
        <div>
          <p class="label font-mono">MARCAS // SELLERS // PROJETOS</p>
          <h2 id="cta-title">Se existe afinidade real, vamos conversar.</h2>
        </div>
        <a 
          class="button dark js-whatsapp-partner" 
          href={whatsappPartnerUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Apresentar uma proposta <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  import { trackTikTokEvent } from '../../utils/tiktok';

  // TikTok Pixel Custom Event Tracker para WhatsApp / Parcerias
  document.querySelectorAll('.js-whatsapp-partner').forEach((button) => {
    button.addEventListener('click', () => {
      trackTikTokEvent('Contact', {
        description: 'Parceria Paulinha WhatsApp'
      });
      trackTikTokEvent('ClickButton', {
        description: 'Propor Parceria WhatsApp'
      });
    });
  });
</script>

<style>
  .page {
    background: #f4f2ed;
    color: var(--neo-text-dark, #0b0b0c);
    overflow-x: hidden;
  }

  .shell {
    width: min(1160px, calc(100% - 2.5rem)); /* 20px de respiro lateral em todas as telas */
    margin: auto;
  }

  /* 1. HERO SECTION */
  .hero {
    position: relative;
    min-height: 92svh;
    padding: calc(6.75rem + var(--sat, 0px)) 0 3.5rem;
    display: grid;
    place-items: center;
    overflow: clip;
    background: #f4f2ed;
  }

  .glow {
    position: absolute;
    inset: 8% auto auto 25%;
    width: min(72vw, 700px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.12), rgba(215, 254, 9, 0.08) 42%, transparent 72%);
    filter: blur(44px);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5.5rem);
  }

  .signal {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #087c82;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .signal i,
  .profile-head i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--neo-acid, #d7fe09);
    box-shadow: 0 0 16px rgba(155, 181, 0, 0.45);
  }

  .paulinha-mark {
    width: min(100%, 720px);
    margin: 0.6rem 0 0.8rem;
    line-height: 0;
  }

  .paulinha-mark img {
    display: block;
    width: 100%;
    height: auto;
    filter: invert(1);
    mix-blend-mode: multiply;
  }

  .lead {
    max-width: 700px;
    font: 500 clamp(1.45rem, 3vw, 2.25rem)/1.13 var(--font-display);
    letter-spacing: -0.045em;
  }

  .lead strong {
    color: #087c82;
    font-weight: 500;
  }

  .note {
    max-width: 560px;
    margin-top: 1.2rem;
    color: #526067;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.8rem;
  }

  .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    border-radius: var(--radius-full, 9999px);
    padding: 0.85rem 1.4rem;
    font: 600 0.74rem var(--font-mono);
    text-decoration: none;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .light {
    background: var(--neo-text-dark, #0b0b0c);
    color: var(--neo-white, #ffffff);
  }

  .light:hover,
  .light:focus-visible {
    background: var(--neo-coral, #fe2c55);
    transform: translateY(-2px);
  }

  .learn {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--neo-text-dark, #0b0b0c);
    font: 600 0.72rem var(--font-mono);
    text-decoration: none;
    border-bottom: 1px solid rgba(5, 11, 15, 0.2);
  }

  .learn:hover {
    border-bottom-color: var(--neo-text-dark, #0b0b0c);
  }

  /* CARD PERFIL TIKTOK FROSTED GLASS */
  .profile {
    position: relative;
    isolation: isolate;
    min-width: 0;
    padding: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: var(--radius-lg, 24px);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.52));
    box-shadow: -5px 0 18px rgba(0, 242, 254, 0.08), 5px 0 18px rgba(254, 44, 85, 0.07), 0 22px 70px rgba(38, 48, 52, 0.14);
    backdrop-filter: blur(28px) saturate(145%);
    -webkit-backdrop-filter: blur(28px) saturate(145%);
  }

  .profile:before {
    content: '';
    position: absolute;
    inset: 1px;
    z-index: -1;
    border-radius: calc(var(--radius-lg, 24px) - 1px);
    background: linear-gradient(118deg, rgba(255, 255, 255, 0.74), transparent 28%, transparent 70%, rgba(0, 242, 254, 0.12));
    pointer-events: none;
  }

  .profile:after {
    content: '';
    position: absolute;
    inset: -2px;
    z-index: -2;
    border-radius: calc(var(--radius-lg, 24px) + 2px);
    background: linear-gradient(90deg, rgba(0, 242, 254, 0.2), transparent 24%, transparent 76%, rgba(254, 44, 85, 0.17));
    filter: blur(5px);
    opacity: 0.7;
    pointer-events: none;
  }

  .profile-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.2rem 0.35rem 0.75rem;
    color: #667278;
    font-size: 0.58rem;
    letter-spacing: 0.13em;
  }

  .profile .tiktok-embed {
    width: 100% !important;
    margin: 0 !important;
    border-radius: calc(var(--radius-md, 16px) - 4px);
    overflow: hidden;
  }

  /* 2. EDITORIAL & BENTO */
  .editorial {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: var(--neo-white, #ffffff);
    color: var(--neo-text-dark, #0b0b0c);
  }

  .section-head {
    display: grid;
    grid-template-columns: 0.7fr 1.4fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  .section-head .signal {
    color: #087c82;
    padding-top: 0.45rem;
  }

  .section-head h2,
  .trust h2,
  .final h2 {
    font: 700 clamp(2.35rem, 5vw, 4.9rem)/0.92 var(--font-display);
    letter-spacing: -0.065em;
  }

  .section-head > p:last-child {
    color: #46565d;
    line-height: 1.6;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-flow: dense;
    gap: 0.75rem;
  }

  .card {
    position: relative;
    min-height: 230px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: var(--radius-md, 16px);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    background: rgba(244, 244, 241, 0.7);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85), 0 12px 35px rgba(38, 48, 52, 0.07);
    backdrop-filter: blur(20px) saturate(130%);
    -webkit-backdrop-filter: blur(20px) saturate(130%);
  }

  .card h3,
  .card p,
  .card blockquote,
  .card ul,
  .card ol,
  .card > span,
  .card > div {
    position: relative;
    z-index: 1;
  }

  .card h3 {
    font: 650 clamp(1.7rem, 3vw, 2.65rem)/0.95 var(--font-display);
    letter-spacing: -0.05em;
  }

  .card > p:not(.label) {
    max-width: 580px;
    margin-top: 1rem;
    color: #46565d;
    line-height: 1.55;
  }

  .label {
    margin-bottom: auto;
    color: #526067;
    font-size: 0.61rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .index {
    position: absolute;
    right: 1.25rem;
    top: 1.25rem;
    color: #7a858a;
    font-size: 0.64rem;
  }

  .seller {
    grid-column: span 7;
    min-height: 310px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: rgba(11, 11, 12, 0.94);
    color: white;
    box-shadow: inset 1px 0 rgba(0, 242, 254, 0.22), inset -1px 0 rgba(254, 44, 85, 0.18), 0 16px 42px rgba(11, 11, 12, 0.16);
  }

  .seller .label { color: var(--neo-cyan, #00f2fe); }
  .seller > p:not(.label) { color: var(--neo-text-muted, #a0aab0); }

  .buyer {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: rgba(0, 242, 254, 0.78);
  }

  .buyer .label,
  .buyer > p:not(.label) { color: #12363b; }

  .thesis {
    grid-column: span 5;
    min-height: 360px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(215, 254, 9, 0.82);
  }

  .thesis blockquote {
    margin: 2.5rem 0 1.25rem;
    font: 650 clamp(2rem, 4vw, 3.5rem)/0.94 var(--font-display);
    letter-spacing: -0.06em;
  }

  .thesis > p:not(.label) { color: #263000; }

  .process {
    grid-column: span 7;
    background: rgba(235, 236, 231, 0.72);
  }

  .process-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(5, 11, 15, 0.13);
    padding-bottom: 0.9rem;
  }

  .process-head .label { margin: 0; }
  .process-head > span { color: #667278; font-size: 0.6rem; }

  .process ol {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1.5rem;
    padding: 0;
    margin: 0;
  }

  .process li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 0.6rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid rgba(5, 11, 15, 0.13);
  }

  .number {
    color: #087c82;
    font-size: 0.62rem;
    padding-top: 0.15rem;
  }

  .process li h3 { font-size: 1rem; letter-spacing: -0.02em; }
  .process li p {
    margin-top: 0.2rem;
    color: #526067;
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .fit {
    grid-column: span 12;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    background: rgba(254, 44, 85, 0.9);
    color: white;
  }

  .fit .label { color: white; }
  .fit ul {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1.5rem;
    padding: 0;
    margin: 0;
  }

  .fit li {
    position: relative;
    padding-left: 1rem;
    font: 600 1rem/1.35 var(--font-display);
  }

  .fit li:before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.47em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: white;
  }

  /* ==========================================================================
     VITRINE DE PRODUTOS // TIKTOK SHOP AFILIADOS
     ========================================================================== */
  .products-showcase-section {
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    background: #f4f2ed;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    color: var(--neo-text-dark, #0b0b0c);
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .showcase-card {
    position: relative;
    display: grid;
    grid-template-columns: 360px 1fr;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.95);
    border-radius: var(--radius-lg, 24px);
    overflow: hidden;
    box-shadow: 0 16px 45px rgba(38, 48, 52, 0.08), inset 0 1px 0 rgba(255, 255, 255, 1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .showcase-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 60px rgba(38, 48, 52, 0.12), inset 0 1px 0 rgba(255, 255, 255, 1);
    border-color: rgba(0, 242, 254, 0.35);
  }

  .showcase-img-wrap {
    position: relative;
    background: linear-gradient(135deg, #f0eee8, #e5e3dc);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: 380px;
  }

  .showcase-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
