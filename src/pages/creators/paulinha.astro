---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Paulinha // IA que aproxima produtos e pessoas';
const pageDescription = 'Conheça Paulinha, creator brasileira gerada por IA para ligar lojistas, marcas e compradores por meio de conteúdo comercial transparente e dirigido por pessoas.';
const steps = [
  ['01', 'Briefing', 'Produto, público e materiais autorizados.'],
  ['02', 'Criação', 'Narrativa e cenas com direção humana.'],
  ['03', 'Revisão', 'Identidade, claims e disclosures conferidos.'],
  ['04', 'Entrega', 'Conteúdo adaptado ao canal aprovado.'],
];
const faqs = [
  ['Paulinha é uma pessoa real?', 'Não. Paulinha é uma creator/personagem brasileira gerada por inteligência artificial, com direção criativa humana.'],
  ['Ela usou ou testou os produtos?', 'Não se presume experiência física. Sem prova atribuível, o conteúdo é uma representação visual baseada em materiais autorizados.'],
  ['Como funciona uma parceria?', 'Começamos pelo produto, público e objetivo. Depois definimos a narrativa, produzimos as peças e submetemos claims e disclosures à revisão.'],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <article class="page">
    <section class="hero" aria-labelledby="page-title">
      <div class="glow" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="signal font-mono"><i></i> CREATOR COMMERCE // IA + DIREÇÃO HUMANA</p>
          <h1 id="page-title" class="paulinha-mark">
            <img src="/assets/paulinha-logo.png" alt="Paulinha" width="900" height="380" decoding="async" fetchpriority="high" />
          </h1>
          <p class="lead">Uma inteligência artificial como ferramenta real de ligação entre <strong>quem vende</strong> e <strong>quem quer comprar melhor.</strong></p>
          <p class="note">Creator brasileira gerada por IA. Estratégia, direção criativa e revisão continuam humanas.</p>
          <div class="actions">
            <a class="button light" href="mailto:neo@neotiktok.com?subject=Parceria%20com%20a%20Paulinha">Propor uma parceria <span aria-hidden="true">↗</span></a>
            <a class="learn" href="#proposta">Entender a proposta <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <aside class="profile" aria-label="Perfil oficial da Paulinha no TikTok">
          <div class="profile-head"><span class="font-mono">PERFIL OFICIAL</span><i></i></div>
          <blockquote class="tiktok-embed" cite="https://www.tiktok.com/@paulinhaazevedomendes" data-unique-id="paulinhaazevedomendes" data-embed-type="creator" style="max-width:780px;min-width:288px"><section><a target="_blank" rel="noopener noreferrer" href="https://www.tiktok.com/@paulinhaazevedomendes?refer=creator_embed">@paulinhaazevedomendes</a></section></blockquote>
          <script async src="https://www.tiktok.com/embed.js"></script>
        </aside>
      </div>
    </section>

    <section class="editorial" id="proposta" aria-labelledby="proposal-title">
      <div class="shell">
        <header class="section-head">
          <p class="signal font-mono"><i></i> A PROPOSTA</p>
          <h2 id="proposal-title">Conteúdo que cria uma ponte, não mais ruído.</h2>
          <p>Paulinha transforma informação comercial em histórias curtas, compreensíveis e revisáveis — sem substituir o julgamento de marcas, lojistas ou compradores.</p>
        </header>
        <div class="bento">
          <article class="card seller"><p class="label font-mono">PARA QUEM VENDE</p><h3>Produto com contexto.</h3><p>Uma forma consistente de traduzir diferenciais, usos possíveis e informações autorizadas em conteúdo mais próximo das pessoas.</p><span class="index font-mono">01</span></article>
          <article class="card buyer"><p class="label font-mono">PARA QUEM COMPRA</p><h3>Clareza antes do clique.</h3><p>Conteúdo direto, identificado quando comercial e sem fingir uma experiência que não aconteceu.</p><span class="index font-mono">02</span></article>
          <article class="card thesis"><p class="label font-mono">NOSSA TESE</p><blockquote>IA não ocupa o lugar da confiança. Ela ajuda a construir a ligação.</blockquote><p>Automação amplia possibilidades; controle humano preserva intenção e responsabilidade.</p></article>
          <article class="card process">
            <div class="process-head"><p class="label font-mono">COMO A IDEIA GANHA FORMA</p><span class="font-mono">04 ETAPAS</span></div>
            <ol>{steps.map(([number, title, text]) => <li><span class="number font-mono">{number}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
          </article>
          <article class="card fit"><p class="label font-mono">PARCERIA SÉRIA É</p><ul><li>produto e origem verificáveis</li><li>claims que possam ser sustentados</li><li>transparência sobre publicidade e IA</li><li>objetivo claro para cada conteúdo</li></ul></article>
        </div>
      </div>
    </section>

    <section class="trust" aria-labelledby="trust-title">
      <div class="shell trust-grid">
        <div>
          <p class="signal font-mono"><i></i> TRANSPARÊNCIA PRIMEIRO</p>
          <h2 id="trust-title">A tecnologia aparece.<br />A responsabilidade também.</h2>
          <p class="trust-copy">Paulinha não é uma pessoa humana. Sua imagem e seus conteúdos são produzidos com IA e direção humana. Publicidade, parceria paga ou afiliação devem ser identificadas quando aplicáveis.</p>
          <div class="tags"><span>IA DECLARADA</span><span>DIREÇÃO HUMANA</span><span>CLAIMS REVISADOS</span></div>
        </div>
        <div class="faq">{faqs.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
      </div>
    </section>

    <section class="final" aria-labelledby="cta-title"><div class="shell final-grid"><div><p class="label font-mono">MARCAS // SELLERS // PROJETOS</p><h2 id="cta-title">Se existe afinidade real, vamos conversar.</h2></div><a class="button dark" href="mailto:neo@neotiktok.com?subject=Parceria%20com%20a%20Paulinha">Apresentar uma proposta <span aria-hidden="true">↗</span></a></div></section>
  </article>
</BaseLayout>

<style>
  .page{background:#f4f2ed;color:var(--neo-text-dark)}.shell{width:min(1160px,calc(100% - 2rem));margin:auto}
  .hero{position:relative;min-height:92svh;padding:calc(6.75rem + var(--sat)) 0 2rem;display:grid;place-items:center;overflow:clip;background:#f4f2ed}.glow{position:absolute;inset:8% auto auto 25%;width:min(72vw,700px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(0,242,254,.12),rgba(215,254,9,.08) 42%,transparent 72%);filter:blur(44px);pointer-events:none}.hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.65fr);align-items:center;gap:clamp(2rem,7vw,7rem)}
  .signal{display:flex;align-items:center;gap:.6rem;color:#087c82;font-size:.64rem;font-weight:600;letter-spacing:.14em}.signal i,.profile-head i{width:6px;height:6px;border-radius:50%;background:var(--neo-acid);box-shadow:0 0 16px rgba(155,181,0,.45)}.paulinha-mark{width:min(100%,720px);margin:.6rem 0 .8rem;line-height:0}.paulinha-mark img{display:block;width:100%;height:auto;filter:invert(1);mix-blend-mode:multiply}.lead{max-width:700px;font:500 clamp(1.4rem,3vw,2.25rem)/1.13 var(--font-display);letter-spacing:-.045em}.lead strong{color:#087c82;font-weight:500}.note{max-width:560px;margin-top:1.2rem;color:#526067;font-size:.98rem;line-height:1.55}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.5rem;margin-top:1.8rem}.button{min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:.8rem;border-radius:var(--radius-full);padding:.85rem 1.15rem;font:600 .72rem var(--font-mono);text-decoration:none}.light{background:var(--neo-text-dark);color:var(--neo-white)}.light:hover,.light:focus-visible{background:var(--neo-coral);transform:translateY(-2px)}.learn{min-height:44px;display:inline-flex;align-items:center;gap:.6rem;color:var(--neo-text-dark);font:600 .72rem var(--font-mono);text-decoration:none;border-bottom:1px solid rgba(5,11,15,.2)}
  .profile{position:relative;isolation:isolate;min-width:0;padding:.85rem;border:1px solid rgba(255,255,255,.82);border-radius:var(--radius-lg);background:linear-gradient(145deg,rgba(255,255,255,.72),rgba(255,255,255,.48));box-shadow:-5px 0 18px rgba(0,242,254,.08),5px 0 18px rgba(254,44,85,.07),0 22px 70px rgba(38,48,52,.14);backdrop-filter:blur(28px) saturate(145%);-webkit-backdrop-filter:blur(28px) saturate(145%)}.profile:before{content:'';position:absolute;inset:1px;z-index:-1;border-radius:calc(var(--radius-lg) - 1px);background:linear-gradient(118deg,rgba(255,255,255,.74),transparent 28%,transparent 70%,rgba(0,242,254,.12));pointer-events:none}.profile:after{content:'';position:absolute;inset:-2px;z-index:-2;border-radius:calc(var(--radius-lg) + 2px);background:linear-gradient(90deg,rgba(0,242,254,.2),transparent 24%,transparent 76%,rgba(254,44,85,.17));filter:blur(5px);opacity:.7;pointer-events:none}.profile-head{display:flex;justify-content:space-between;align-items:center;padding:.2rem .35rem .75rem;color:#667278;font-size:.58rem;letter-spacing:.13em}.profile .tiktok-embed{width:100%;margin:0;border-radius:calc(var(--radius-md) - 4px);overflow:hidden}
  .editorial{padding:clamp(4rem,8vw,7rem) 0;background:var(--neo-white);color:var(--neo-text-dark)}.section-head{display:grid;grid-template-columns:.7fr 1.4fr 1fr;gap:2rem;align-items:start;margin-bottom:2.5rem}.section-head .signal{color:#087c82;padding-top:.45rem}.section-head h2,.trust h2,.final h2{font:700 clamp(2.35rem,5vw,4.9rem)/.92 var(--font-display);letter-spacing:-.065em}.section-head>p:last-child{color:#46565d;line-height:1.6}
  .bento{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-flow:dense;gap:.75rem}.card{position:relative;min-height:230px;overflow:hidden;border:1px solid rgba(255,255,255,.75);border-radius:var(--radius-md);padding:clamp(1.25rem,2.5vw,2rem);background:rgba(244,244,241,.7);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),0 12px 35px rgba(38,48,52,.07);backdrop-filter:blur(20px) saturate(130%);-webkit-backdrop-filter:blur(20px) saturate(130%)}.card:after{content:'';position:absolute;inset:0;border-radius:inherit;background:linear-gradient(122deg,rgba(0,242,254,.08),transparent 20%,transparent 78%,rgba(254,44,85,.07));mix-blend-mode:multiply;pointer-events:none}.card h3,.card p,.card blockquote,.card ul,.card ol,.card>span,.card>div{position:relative;z-index:1}.card h3{font:650 clamp(1.7rem,3vw,2.65rem)/.95 var(--font-display);letter-spacing:-.05em}.card>p:not(.label){max-width:580px;margin-top:1rem;color:#46565d;line-height:1.55}.label{margin-bottom:auto;color:#526067;font-size:.61rem;font-weight:600;letter-spacing:.12em}.index{position:absolute;right:1.25rem;top:1.25rem;color:#7a858a;font-size:.64rem}.seller{grid-column:span 7;min-height:310px;display:flex;flex-direction:column;justify-content:flex-end;background:rgba(11,11,12,.94);color:white;box-shadow:inset 1px 0 rgba(0,242,254,.22),inset -1px 0 rgba(254,44,85,.18),0 16px 42px rgba(11,11,12,.16)}.seller .label{color:var(--neo-cyan)}.seller>p:not(.label){color:var(--neo-text-muted)}.buyer{grid-column:span 5;display:flex;flex-direction:column;justify-content:flex-end;background:rgba(0,242,254,.78)}.buyer .label,.buyer>p:not(.label){color:#12363b}.thesis{grid-column:span 5;min-height:360px;display:flex;flex-direction:column;justify-content:space-between;background:rgba(215,254,9,.82)}.thesis blockquote{margin:2.5rem 0 1.25rem;font:650 clamp(2rem,4vw,3.5rem)/.94 var(--font-display);letter-spacing:-.06em}.thesis>p:not(.label){color:#263000}.process{grid-column:span 7;background:rgba(235,236,231,.72)}.process-head{display:flex;justify-content:space-between;gap:1rem;border-bottom:1px solid rgba(5,11,15,.13);padding-bottom:.9rem}.process-head .label{margin:0}.process-head>span{color:#667278;font-size:.6rem}.process ol{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:0 1.5rem}.process li{display:grid;grid-template-columns:30px 1fr;gap:.6rem;padding:1.1rem 0;border-bottom:1px solid rgba(5,11,15,.13)}.number{color:#087c82;font-size:.62rem;padding-top:.15rem}.process li h3{font-size:1rem;letter-spacing:-.02em}.process li p{margin-top:.2rem;color:#526067;font-size:.78rem;line-height:1.4}.fit{grid-column:span 12;min-height:0;display:grid;grid-template-columns:1fr 2fr;gap:2rem;background:rgba(254,44,85,.9);color:white}.fit .label{color:white}.fit ul{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:.75rem 1.5rem}.fit li{position:relative;padding-left:1rem;font:600 1rem/1.35 var(--font-display)}.fit li:before{content:'';position:absolute;left:0;top:.47em;width:5px;height:5px;border-radius:50%;background:white}
  .trust{padding:clamp(4rem,8vw,7rem) 0;border-bottom:1px solid var(--neo-border);background:var(--neo-bg);color:var(--neo-white)}.trust .signal{color:var(--neo-cyan)}.trust-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(3rem,8vw,7rem)}.trust h2{margin:1.2rem 0 1.4rem}.trust-copy{max-width:650px;color:var(--neo-text-muted);line-height:1.65}.tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.6rem}.tags span{border:1px solid var(--neo-border);border-radius:var(--radius-full);padding:.45rem .65rem;color:var(--neo-text-muted);font:.58rem var(--font-mono);letter-spacing:.08em}.faq{border-top:1px solid var(--neo-border)}details{border-bottom:1px solid var(--neo-border)}summary{min-height:58px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:1rem 0;font:600 1rem var(--font-display)}summary::-webkit-details-marker{display:none}summary span{color:var(--neo-cyan);font-family:var(--font-mono)}details p{padding:0 2rem 1.25rem 0;color:var(--neo-text-muted);font-size:.9rem;line-height:1.55}
  .final{padding:clamp(3.5rem,7vw,6rem) 0;background:var(--neo-acid);color:var(--neo-text-dark)}.final-grid{display:grid;grid-template-columns:1fr auto;align-items:end;gap:2rem}.final h2{max-width:840px;margin-top:1rem}.dark{background:var(--neo-text-dark);color:white;white-space:nowrap}.dark:hover,.dark:focus-visible{background:white;color:var(--neo-text-dark);transform:translateY(-2px)}
  :global(#site-header:not(.is-scrolled) .header-logo){color:var(--neo-text-dark)}:global(#site-header:not(.is-scrolled) .menu-toggle){color:var(--neo-text-dark);border-color:rgba(5,11,15,.16);background:rgba(255,255,255,.4)}
  @media(max-width:760px){.shell{width:min(calc(100% - 1.25rem),1160px)}.hero{min-height:auto;padding-top:calc(6rem + var(--sat))}.hero-grid,.section-head,.trust-grid,.final-grid{grid-template-columns:1fr}.hero-grid{gap:2.25rem}.paulinha-mark{width:100%;margin:.35rem 0 .45rem}.lead{font-size:clamp(1.3rem,6.4vw,1.75rem)}.button.light{flex:1 1 190px}.section-head{gap:1rem;margin-bottom:2rem}.section-head .signal{padding:0}.section-head h2,.trust h2,.final h2{font-size:clamp(2.3rem,12vw,3.6rem)}.bento{grid-template-columns:1fr 1fr;gap:.55rem}.card{grid-column:span 2;min-height:0;padding:1.15rem}.seller,.buyer{min-height:250px}.thesis{min-height:310px}.process ol{grid-template-columns:1fr}.fit{grid-template-columns:1fr;gap:1.25rem}.fit ul{grid-template-columns:1fr;gap:.6rem}.trust-grid{gap:2.5rem}.dark{width:100%}}
  @media(min-width:520px) and (max-width:760px){.seller,.buyer{grid-column:span 1;min-height:300px}}
  @media(prefers-reduced-motion:reduce){.button{transition:none}}
</style>
