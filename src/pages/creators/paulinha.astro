---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Paulinha // Creator IA neøflow TikTok';
const pageDescription = 'Conheça Paulinha, creator brasileira gerada por IA para conectar marcas, lojistas e compradores no TikTok com direção humana e transparência comercial.';

const whatsappPartnerUrl = 'https://wa.me/556282705594?text=Ol%C3%A1%2C%20quero%20propor%20uma%20parceria%20com%20a%20Paulinha%20no%20TikTok.';

const steps = [
  ['01', 'Briefing', 'Alinhamento de produto, público-alvo e materiais oficiais da marca.'],
  ['02', 'Criação', 'Roteirização, narrativa e cenas com direção criativa 100% humana.'],
  ['03', 'Revisão', 'Validação de claims, benefícios reais e identificação de publicidade.'],
  ['04', 'Entrega', 'Publicação contextual no TikTok com foco em engajamento e conversão.'],
];

const faqs = [
  ['Paulinha é uma pessoa real?', 'Não. Paulinha é uma creator e personagem brasileira gerada por inteligência artificial, operada com direção de arte, estratégia e curadoria humana.'],
  ['Ela usou ou testou os produtos fisicamente?', 'Não se presume experiência física pessoal. Os conteúdos são representações visuais contextualizadas, construídas estritamente com base nos dados, especificações e materiais autorizados pelo lojista ou marca.'],
  ['Como funciona uma parceria comercial?', 'Iniciamos pelo WhatsApp para entender o produto e os objetivos da campanha. Em seguida, estruturamos a narrativa, produzimos as peças em alta definição e validamos todos os detalhes antes da publicação.'],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <article class="creator-page">
    <!-- 1. HERO: APRESENTAÇÃO & HEADLINE EM DARK CANVAS -->
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="glow glow-cyan" aria-hidden="true"></div>
      <div class="glow glow-acid" aria-hidden="true"></div>
      
      <div class="shell hero-content">
        <div class="badge-signal font-mono">
          <span class="pulse-dot"></span>
          CREATOR COMMERCE · IA + DIREÇÃO HUMANA
        </div>

        <div class="paulinha-brand">
          <img 
            src="/assets/paulinha-logo.png" 
            alt="Paulinha" 
            width="900" 
            height="380" 
            decoding="async" 
            fetchpriority="high"
          />
        </div>

        <h1 id="hero-title" class="hero-headline">
          Uma inteligência artificial que aproxima <strong>produtos</strong> e <strong>pessoas</strong> com clareza.
        </h1>

        <p class="hero-subtitle">
          Creator brasileira gerada por IA para conectar lojistas, marcas e compradores no TikTok. Estratégia, narrativa e responsabilidade continuam 100% humanas.
        </p>

        <div class="hero-actions">
          <a 
            class="btn btn-whatsapp" 
            href={whatsappPartnerUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="Propor uma parceria com a Paulinha pelo WhatsApp"
          >
            <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.79.82h.001c3.182 0 5.768-2.586 5.769-5.766.001-3.181-2.585-5.766-5.77-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.745 0-3.38-.456-4.81-1.251l-5.19 1.359 1.383-5.053c-.886-1.488-1.383-3.218-1.383-5.055 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
            </svg>
            Propor uma parceria
            <span class="arrow" aria-hidden="true">↗</span>
          </a>

          <a class="btn btn-secondary" href="#perfil">
            Ver perfil no TikTok
            <span class="arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. PERFIL OFICIAL: EMBED NATIVO DO TIKTOK -->
    <section class="profile-section" id="perfil" aria-labelledby="profile-title">
      <div class="shell">
        <div class="profile-card">
          <div class="profile-info">
            <div class="badge-signal font-mono">
              <span class="pulse-dot"></span>
              PRESENÇA OFICIAL
            </div>
            <h2 id="profile-title">Acompanhe a Paulinha na prática.</h2>
            <p>Vídeos curtos, reviews visuais e conteúdos contextuais desenvolvidos para o comércio de descoberta no TikTok.</p>
            
            <div class="profile-tags font-mono">
              <span>@paulinhaazevedomendes</span>
              <span>VERIFICADO NEØFLOW</span>
            </div>
          </div>

          <div class="tiktok-container">
            <div class="tiktok-frame">
              <div class="tiktok-topbar font-mono">
                <span>TIKTOK CREATOR</span>
                <span class="live-tag"><i></i> ATIVO</span>
              </div>
              <div class="tiktok-body">
                <blockquote 
                  class="tiktok-embed" 
                  cite="https://www.tiktok.com/@paulinhaazevedomendes" 
                  data-unique-id="paulinhaazevedomendes" 
                  data-embed-type="creator" 
                  style="max-width:780px;min-width:280px"
                >
                  <section>
                    <a target="_blank" rel="noopener noreferrer" href="https://www.tiktok.com/@paulinhaazevedomendes?refer=creator_embed">
                      @paulinhaazevedomendes
                    </a>
                  </section>
                </blockquote>
                <script async src="https://www.tiktok.com/embed.js"></script>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. PROPOSTA: BENTO GRID DE VALOR -->
    <section class="editorial-section" id="proposta" aria-labelledby="editorial-title">
      <div class="shell">
        <header class="section-header">
          <div class="badge-signal font-mono">
            <span class="pulse-dot"></span>
            A PROPOSTA
          </div>
          <h2 id="editorial-title">Conteúdo que cria uma ponte, não ruído.</h2>
          <p>Transformamos informações de produtos em narrativas atraentes, autênticas e transparentes.</p>
        </header>

        <div class="bento-grid">
          <article class="bento-card card-seller">
            <span class="card-num font-mono">01</span>
            <p class="card-label font-mono">PARA QUEM VENDE</p>
            <h3>Produto com contexto real.</h3>
            <p>Uma forma consistente de traduzir diferenciais, modos de uso e especificações em vídeos que engajam o público certo.</p>
          </article>

          <article class="bento-card card-buyer">
            <span class="card-num font-mono">02</span>
            <p class="card-label font-mono">PARA QUEM COMPRA</p>
            <h3>Clareza antes do clique.</h3>
            <p>Conteúdo direto, sem promessas vazias e identificado de forma transparente quando comercial.</p>
          </article>

          <article class="bento-card card-thesis">
            <p class="card-label font-mono">NOSSA TESE</p>
            <blockquote>"A inteligência artificial amplia a escala; a direção humana preserva a confiança."</blockquote>
          </article>

          <article class="bento-card card-steps">
            <div class="steps-header">
              <p class="card-label font-mono">COMO FUNCIONA O PROCESSO</p>
              <span class="font-mono steps-tag">04 ETAPAS</span>
            </div>
            <ol class="steps-list">
              {steps.map(([num, title, desc]) => (
                <li>
                  <span class="step-num font-mono">{num}</span>
                  <div>
                    <h4>{title}</h4>
                    <p>{desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </article>

          <article class="bento-card card-guidelines">
            <p class="card-label font-mono">CRITÉRIOS DE PARCERIA</p>
            <ul class="guidelines-list">
              <li>Origem e qualidade do produto verificáveis</li>
              <li>Benefícios e informações que possam ser sustentados</li>
              <li>Transparência total sobre publicidade e criação por IA</li>
              <li>Alinhamento claro com o público da Paulinha</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 4. TRANSPARÊNCIA & FAQ -->
    <section class="trust-section" aria-labelledby="trust-title">
      <div class="shell trust-layout">
        <div class="trust-intro">
          <div class="badge-signal font-mono">
            <span class="pulse-dot"></span>
            TRANSPARÊNCIA & RESPONSABILIDADE
          </div>
          <h2 id="trust-title">A tecnologia aparece.<br />A ética também.</h2>
          <p>
            Paulinha é uma personagem sintética desenvolvida com tecnologia de ponta. A curadoria, o posicionamento e os roteiros são assinados pelo time da neøflow.
          </p>
          <div class="trust-pills font-mono">
            <span>IA DECLARADA</span>
            <span>DIREÇÃO HUMANA</span>
            <span>COMPLIANCE PUBLICITÁRIO</span>
          </div>
        </div>

        <div class="faq-container">
          {faqs.map(([q, a], idx) => (
            <details open={idx === 0} class="faq-item">
              <summary class="faq-summary">
                <span>{q}</span>
                <span class="faq-icon font-mono">+</span>
              </summary>
              <p class="faq-answer">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. CTA FINAL: WHATSAPP DIRETO -->
    <section class="final-cta-section" aria-labelledby="cta-title">
      <div class="shell">
        <div class="cta-banner">
          <div class="cta-text">
            <p class="card-label font-mono">MARCAS · SELLERS · AGÊNCIAS</p>
            <h2 id="cta-title">Pronto para colocar seus produtos em destaque?</h2>
            <p>Fale diretamente com o time de operações e conecte sua marca à audiência da Paulinha.</p>
          </div>
          <div class="cta-action">
            <a 
              class="btn btn-whatsapp-lg js-whatsapp-partner" 
              href={whatsappPartnerUrl} 
              target="_blank" 
              rel="noopener noreferrer"
            >
              <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.771.82 2.79.82h.001c3.182 0 5.768-2.586 5.769-5.766.001-3.181-2.585-5.766-5.77-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.745 0-3.38-.456-4.81-1.251l-5.19 1.359 1.383-5.053c-.886-1.488-1.383-3.218-1.383-5.055 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
              </svg>
              Iniciar conversa no WhatsApp
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  interface TikTokAnalytics {
    track: (event: string, params?: Record<string, any>) => void;
  }

  declare global {
    interface Window {
      ttq?: TikTokAnalytics;
    }
  }

  // TikTok Pixel Custom Event Tracker para WhatsApp / Parcerias
  document.querySelectorAll('.js-whatsapp-partner, .btn-whatsapp').forEach((button) => {
    button.addEventListener('click', () => {
      if (typeof window !== 'undefined' && window.ttq) {
        window.ttq.track('Contact', {
          content_name: 'Parceria Paulinha WhatsApp',
          content_type: 'creator_partnership',
          content_category: 'Creator Commerce',
          value: 0,
          currency: 'BRL'
        });
        window.ttq.track('ClickButton', {
          content_name: 'Propor Parceria WhatsApp'
        });
      }
    });
  });
</script>

<style>
  /* ==========================================================================
     GLOBAL TOKENS & CANVAS (DARK METALLIC)
     ========================================================================== */
  .creator-page {
    background-color: #07090b;
    color: #f0f4f8;
    min-height: 100vh;
    overflow-x: hidden;
  }

  .shell {
    width: min(1180px, calc(100% - 2.5rem));
    margin-inline: auto;
  }

  /* BADGE / SIGNAL */
  .badge-signal {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--neo-cyan, #00f2fe);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-full, 9999px);
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.22);
    box-shadow: 0 0 16px rgba(0, 242, 254, 0.12);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--neo-acid, #d7fe09);
    box-shadow: 0 0 10px #d7fe09;
  }

  /* BUTTONS */
  .btn {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-full, 9999px);
    font: 700 0.78rem var(--font-mono);
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    cursor: pointer;
  }

  .btn-whatsapp {
    background: #25d366;
    color: #04180d;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.35);
  }

  .btn-whatsapp:hover {
    background: #22bf5b;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(37, 211, 102, 0.5);
  }

  .btn-whatsapp-lg {
    background: #25d366;
    color: #04180d;
    font-size: 0.84rem;
    padding: 1.1rem 2rem;
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.4);
  }

  .btn-whatsapp-lg:hover {
    background: #22bf5b;
    transform: translateY(-2px);
    box-shadow: 0 10px 32px rgba(37, 211, 102, 0.55);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(12px);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  /* ==========================================================================
     1. HERO SECTION
     ========================================================================== */
  .hero-section {
    position: relative;
    padding: calc(6.5rem + var(--sat, 0px)) 0 4.5rem;
    overflow: clip;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(65px);
    pointer-events: none;
    opacity: 0.25;
  }

  .glow-cyan {
    top: 5%;
    left: 10%;
    width: min(60vw, 550px);
    aspect-ratio: 1;
    background: radial-gradient(circle, #00f2fe 0%, transparent 70%);
  }

  .glow-acid {
    top: 20%;
    right: 15%;
    width: min(50vw, 450px);
    aspect-ratio: 1;
    background: radial-gradient(circle, #d7fe09 0%, transparent 70%);
  }

  .hero-content {
    position: relative;
    max-width: 860px;
  }

  .paulinha-brand {
    width: min(100%, 460px);
    margin: 1.4rem 0 1.6rem;
  }

  .paulinha-brand img {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(1.08) drop-shadow(0 4px 24px rgba(0, 242, 254, 0.18));
  }

  .hero-headline {
    font: 600 clamp(1.85rem, 4.5vw, 3.1rem)/1.12 var(--font-display);
    letter-spacing: -0.04em;
    color: #ffffff;
    margin-bottom: 1.2rem;
  }

  .hero-headline strong {
    color: var(--neo-cyan, #00f2fe);
    font-weight: 700;
  }

  .hero-subtitle {
    max-width: 640px;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #9aa5ad;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 2.4rem;
  }

  /* ==========================================================================
     2. PROFILE SECTION (TIKTOK EMBED)
     ========================================================================== */
  .profile-section {
    padding: 2.5rem 0 5rem;
  }

  .profile-card {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 3.5rem;
    align-items: center;
    padding: clamp(2rem, 4.5vw, 3.75rem);
    border-radius: var(--radius-lg, 24px);
    background: linear-gradient(145deg, rgba(20, 24, 28, 0.75), rgba(12, 15, 18, 0.9));
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
  }

  .profile-info h2 {
    font: 700 clamp(1.8rem, 3.2vw, 2.6rem)/1.1 var(--font-display);
    letter-spacing: -0.04em;
    color: #ffffff;
    margin: 1rem 0 1rem;
  }

  .profile-info p {
    color: #9aa5ad;
    line-height: 1.65;
    font-size: 1.02rem;
  }

  .profile-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.8rem;
  }

  .profile-tags span {
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-full, 9999px);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.65rem;
    color: var(--neo-cyan, #00f2fe);
  }

  .tiktok-frame {
    border-radius: var(--radius-md, 16px);
    background: #030405;
    border: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
  }

  .tiktok-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.1rem;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: #9aa5ad;
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }

  .live-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #25d366;
  }

  .live-tag i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 0 8px #25d366;
  }

  .tiktok-body {
    padding: 0.75rem;
    display: flex;
    justify-content: center;
    background: #000000;
  }

  .tiktok-body .tiktok-embed {
    width: 100% !important;
    margin: 0 !important;
  }

  /* ==========================================================================
     3. EDITORIAL & BENTO GRID
     ========================================================================== */
  .editorial-section {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: #090b0e;
  }

  .section-header {
    display: grid;
    grid-template-columns: 0.8fr 1.4fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 3.25rem;
  }

  .section-header h2 {
    font: 700 clamp(2.1rem, 4vw, 3.8rem)/0.96 var(--font-display);
    letter-spacing: -0.05em;
    color: #ffffff;
  }

  .section-header p {
    color: #9aa5ad;
    line-height: 1.6;
    font-size: 1.02rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-flow: dense;
    gap: 1rem;
  }

  .bento-card {
    position: relative;
    padding: clamp(1.6rem, 2.8vw, 2.25rem);
    border-radius: var(--radius-md, 16px);
    background: rgba(18, 22, 26, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .card-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: auto;
    color: #72808a;
  }

  .card-num {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .bento-card h3 {
    font: 650 clamp(1.6rem, 2.6vw, 2.3rem)/1.02 var(--font-display);
    letter-spacing: -0.04em;
    color: #ffffff;
    margin: 1.4rem 0 0.8rem;
  }

  .bento-card p:not(.card-label) {
    color: #9aa5ad;
    line-height: 1.6;
    font-size: 0.98rem;
  }

  .card-seller {
    grid-column: span 7;
    min-height: 310px;
    border-color: rgba(0, 242, 254, 0.25);
    background: linear-gradient(145deg, rgba(0, 242, 254, 0.05), rgba(16, 20, 24, 0.85));
  }

  .card-seller .card-label { color: var(--neo-cyan, #00f2fe); }

  .card-buyer {
    grid-column: span 5;
    border-color: rgba(215, 254, 9, 0.22);
    background: linear-gradient(145deg, rgba(215, 254, 9, 0.04), rgba(16, 20, 24, 0.85));
  }

  .card-buyer .card-label { color: var(--neo-acid, #d7fe09); }

  .card-thesis {
    grid-column: span 5;
    min-height: 340px;
    background: linear-gradient(145deg, rgba(254, 44, 85, 0.08), rgba(18, 22, 26, 0.9));
    border-color: rgba(254, 44, 85, 0.24);
  }

  .card-thesis blockquote {
    font: 600 clamp(1.5rem, 2.5vw, 2.1rem)/1.15 var(--font-display);
    letter-spacing: -0.04em;
    color: #ffffff;
    margin: 1.5rem 0 0;
  }

  .card-steps {
    grid-column: span 7;
    background: rgba(18, 22, 26, 0.8);
  }

  .steps-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }

  .steps-tag {
    font-size: 0.64rem;
    color: var(--neo-cyan, #00f2fe);
  }

  .steps-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
