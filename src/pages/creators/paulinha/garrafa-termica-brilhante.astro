---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const product = {
  title: 'Garrafa de Água Térmica Brilhante com Base em Silicone, Tampa Antivazamento e Alça Resistente',
  shortTitle: 'Garrafa Térmica Brilhante c/ Silicone',
  seller: 'Vibe da Garrafa',
  rating: 4.8,
  reviewsCount: 5144,
  salesCount: '24.3k+',
  price: '42,90',
  originalPrice: '71,20',
  discount: '-40%',
  affiliateUrl: 'https://vt.tiktok.com/ZS9Bq3aQemhum-m31ZJ/',
  colors: [
    { name: 'Pink Glitter', hex: '#e91e63', active: true, tag: 'Destaque Paulinha' },
    { name: 'Lilás', hex: '#ba68c8', active: false },
    { name: 'Crème', hex: '#f5f5dc', active: false },
    { name: 'Verde Água', hex: '#4db6ac', active: false },
    { name: 'Azul Claro', hex: '#64b5f6', active: false },
    { name: 'Roxo', hex: '#7b1fa2', active: false },
    { name: 'Azul Escuro', hex: '#1565c0', active: false },
    { name: 'Rosa Claro', hex: '#f48fb1', active: false },
    { name: 'Verde Esmeralda', hex: '#2e7d32', active: false },
    { name: 'Preto Fosco', hex: '#212121', active: false },
    { name: 'Rose Titanium', hex: '#c59b97', active: false },
  ],
  capacities: ['350ml', '600ml', '800ml', '1 Litro'],
  defaultCapacity: '600ml',
  images: [
    {
      src: '/assets/creators/paulinha/garrafa-termica/paulinha-garrafa-rosa-detalhe.png',
      alt: 'Paulinha segurando a Garrafa Térmica Brilhante Pink com base em silicone',
      label: 'Destaque Paulinha'
    },
    {
      src: '/assets/creators/paulinha/garrafa-termica/paulinha-garrafa-rosa-look.jpg',
      alt: 'Look fitness completo da Paulinha com Garrafa Térmica e Bolsa Atomic',
      label: 'Look Fitness'
    },
    {
      src: '/assets/creators/paulinha/garrafa-termica/tiktok-shop-produto.png',
      alt: 'Detalhes oficiais da Garrafa Térmica no TikTok Shop - Cores e Capacidades',
      label: 'Cores & Modelos'
    },
    {
      src: '/assets/creators/paulinha/garrafa-termica/paulinha-bolsa-look.png',
      alt: 'Detalhe do acessório e bolsa de treino combinando',
      label: 'Acessórios'
    }
  ],
  highlights: [
    {
      icon: '❄️🔥',
      title: 'Isolamento Térmico Duplo',
      desc: 'Mantém água gelada por até 12 horas ou café/chá quente por até 8 horas.'
    },
    {
      icon: '✨',
      title: 'Acabamento Brilho Holográfico',
      desc: 'Textura brilhante premium resistente a arranhões e descamação.'
    },
    {
      icon: '🛡️',
      title: 'Base Protetora em Silicone',
      desc: 'Absorve impactos, previne amassados e evita barulho ao apoiar na mesa.'
    },
    {
      icon: '🔒',
      title: 'Tampa 100% Antivazamento',
      desc: 'Trava de segurança reforçada e vedação interna hermética de alta vedação.'
    },
    {
      icon: '👜',
      title: 'Alça Ergonômica Resistente',
      desc: 'Perfeita para levar para a academia, faculdade, trabalho ou caminhadas.'
    },
    {
      icon: '🌿',
      title: 'Livre de BPA e Atóxica',
      desc: 'Aço inox sanitário de grau alimentício que não altera o sabor da bebida.'
    }
  ]
};

const pageTitle = `${product.title} // Escolha da Paulinha no TikTok Shop`;
const pageDescription = `Garrafa Térmica Brilhante com Base em Silicone por R$ ${product.price} (-40% OFF) no TikTok Shop. Vendido por ${product.seller}. Escolha oficial da creator Paulinha.`;

// Schema.org Product Rich Snippet
const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.title,
  "image": product.images.map(img => `https://neotiktok.com${img.src}`),
  "description": pageDescription,
  "brand": {
    "@type": "Brand",
    "name": product.seller
  },
  "offers": {
    "@type": "Offer",
    "url": product.affiliateUrl,
    "priceCurrency": "BRL",
    "price": product.price.replace(',', '.'),
    "priceValidUntil": "2026-12-31",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": product.seller
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": product.rating.toString(),
    "reviewCount": product.reviewsCount.toString()
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <main class="product-page">
    <div class="product-ambient-glow" aria-hidden="true"></div>

    <div class="product-container">
      <!-- Breadcrumb & Creator Endorsement Pill -->
      <nav class="pdp-breadcrumbs" aria-label="Navegação estrutural">
        <a href="/" class="crumb-link">Início</a>
        <span class="crumb-sep">/</span>
        <a href="/creators/paulinha" class="crumb-link">Paulinha</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current font-mono">Garrafa Térmica Brilhante</span>
      </nav>

      <!-- Creator Banner -->
      <aside class="creator-badge-bar" aria-label="Indicação de Creator Oficial">
        <div class="creator-avatar">
          <img src="/assets/paulinha-logo.png" alt="Paulinha Logo" width="36" height="36" />
        </div>
        <div class="creator-meta">
          <span class="creator-tag font-mono">VITRINE VERIFICADA // UGC CREATOR</span>
          <p class="creator-quote">
            <strong>Indicação da Paulinha</strong> (@paulinhaazevedomendes): 
            <em>"O brilho dela ao vivo é surreal e não sua nada na bolsa de treino!"</em>
          </p>
        </div>
        <a href="https://www.tiktok.com/@paulinhaazevedomendes" target="_blank" rel="noopener noreferrer" class="creator-profile-link font-mono">
          Ver Perfil ↗
        </a>
      </aside>

      <!-- Main Product Grid -->
      <section class="pdp-main-grid" aria-labelledby="product-title">
        <!-- 1. Interactive Gallery -->
        <div class="pdp-gallery-col">
          <div class="gallery-main-frame">
            <span class="gallery-badge font-mono">🔥 40% OFF</span>
            <img
              id="main-product-image"
              src={product.images[0].src}
              alt={product.images[0].alt}
              class="main-img"
              width="600"
              height="800"
              decoding="async"
              fetchpriority="high"
            />
          </div>

          <div class="gallery-thumbs" role="tablist" aria-label="Fotos do produto">
            {product.images.map((img, idx) => (
              <button
                type="button"
                class={`thumb-btn ${idx === 0 ? 'active' : ''}`}
                data-src={img.src}
                data-alt={img.alt}
                aria-label={`Ver foto ${idx + 1}: ${img.label}`}
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
              >
                <img src={img.src} alt="" width="80" height="80" loading="lazy" />
                <span class="thumb-label font-mono">{img.label}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- 2. Product Details & Buy Box -->
        <div class="pdp-buybox-col">
          <div class="seller-pill font-mono">
            <span class="verified-dot"></span>
            Vendido por <strong>{product.seller}</strong> // TikTok Shop Oficial
          </div>

          <h1 id="product-title" class="product-title font-display">
            {product.title}
          </h1>

          <!-- Social Proof Bar -->
          <div class="ratings-sales-bar">
            <div class="stars-wrap" aria-label={`Avaliação ${product.rating} de 5 estrelas`}>
              <span class="star-icon">★</span>
              <strong>{product.rating}</strong>
              <span class="reviews-count font-mono">({product.reviewsCount} avaliações)</span>
            </div>
            <span class="bar-divider">•</span>
            <div class="sales-wrap font-mono">
              <span class="fire-icon">⚡</span>
              <strong>{product.salesCount}</strong> vendidos no TikTok
            </div>
          </div>

          <!-- Price Card -->
          <div class="price-box">
            <div class="price-row">
              <span class="discount-badge font-mono">{product.discount}</span>
              <span class="current-price">
                <small>R$</small> {product.price}
              </span>
              <span class="original-price font-mono">R$ {product.originalPrice}</span>
            </div>
            <div class="shipping-tag font-mono">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span><strong>Frete Grátis</strong> elegível no TikTok Shop</span>
            </div>
          </div>

          <!-- Color Selector (Visual Chips) -->
          <div class="selector-group">
            <div class="selector-header">
              <span class="selector-label font-mono">Cor selecionada:</span>
              <strong id="selected-color-name" class="font-mono">Pink Glitter</strong>
            </div>
            <div class="color-chips" role="radiogroup" aria-label="Escolha a cor">
              {product.colors.map((c) => (
                <button
                  type="button"
                  class={`color-chip ${c.active ? 'active' : ''}`}
                  style={`--chip-color: ${c.hex};`}
                  data-color-name={c.name}
                  aria-label={`Cor: ${c.name}`}
                  title={c.name}
                >
                  <span class="color-swatch"></span>
                  <span class="chip-name">{c.name}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Capacity Selector -->
          <div class="selector-group">
            <div class="selector-header">
              <span class="selector-label font-mono">Capacidade:</span>
              <strong id="selected-capacity" class="font-mono">{product.defaultCapacity}</strong>
            </div>
            <div class="capacity-pills" role="radiogroup" aria-label="Escolha a capacidade">
              {product.capacities.map((cap) => (
                <button
                  type="button"
                  class={`cap-pill ${cap === product.defaultCapacity ? 'active' : ''}`}
                  data-capacity={cap}
                  aria-label={`Tamanho: ${cap}`}
                >
                  {cap}
                </button>
              ))}
            </div>
          </div>

          <!-- CTA Affiliate Button -->
          <div class="cta-actions-wrap">
            <a
              href={product.affiliateUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-buy-tiktok js-affiliate-track"
              id="main-affiliate-cta"
            >
              <span class="tiktok-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298 0 .594.044.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.27 6.27 0 0 0 1.89-4.49V8.75a8.28 8.28 0 0 0 4.88 1.57V6.87c-.33-.04-.67-.1-1-.18z"/>
                </svg>
              </span>
              <span class="btn-text">
                <strong>COMPRAR AGORA NO TIKTOK SHOP</strong>
                <small class="font-mono">Desconto de 40% aplicado no link oficial</small>
              </span>
              <span class="arrow-icon">→</span>
            </a>

            <p class="cta-guarantee font-mono">
              🔒 Compra 100% protegida pelo TikTok Shop com garantia de devolução
            </p>
          </div>
        </div>
      </section>

      <!-- Section: Key Highlights & Differential Cards -->
      <section class="pdp-highlights-section" aria-labelledby="highlights-title">
        <div class="section-title-wrap">
          <span class="section-tag font-mono">TECNOLOGIA & DESIGN</span>
          <h2 id="highlights-title" class="font-display">Por Que Essa Garrafa Virou Tendência</h2>
        </div>

        <div class="highlights-grid">
          {product.highlights.map((item) => (
            <article class="highlight-card">
              <div class="card-icon">{item.icon}</div>
              <h3 class="card-title font-display">{item.title}</h3>
              <p class="card-desc">{item.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Section: Paulinha's UGC Story / Look de Treino -->
      <section class="pdp-ugc-showcase" aria-labelledby="ugc-title">
        <div class="ugc-container">
          <div class="ugc-image-side">
            <img
              src="/assets/creators/paulinha/garrafa-termica/paulinha-garrafa-rosa-look.jpg"
              alt="Paulinha com seu look fitness e a garrafa térmica brilhante"
              class="ugc-showcase-img"
              loading="lazy"
              width="500"
              height="750"
            />
          </div>
          <div class="ugc-content-side">
            <div class="ugc-tag font-mono">CURADORIA PAULINHA // CREATOR COMMERCE</div>
            <h2 id="ugc-title" class="font-display">
              A garrafa perfeita para o dia a dia, treino e trabalho
            </h2>
            <div class="ugc-text">
              <p>
                <em>"Quem me acompanha sabe que eu não abro mão de hidratação com estilo. O acabamento com glitter é sofisticado sem ser exagerado, e a base de silicone é o diferencial real — ela não escorrega em esteira, não amassa e não faz barulho ao pousar na mesa."</em>
              </p>
              <p>
                Comprando pelo link de afiliada oficial, você apoia as produções de conteúdo da Paulinha no TikTok e garante o preço promocional com entrega direta da loja <strong>Vibe da Garrafa</strong>.
              </p>
            </div>

            <div class="ugc-stats-row font-mono">
              <div class="ugc-stat">
                <span class="num">12h</span>
                <span class="lbl">Gelo Preservado</span>
              </div>
              <div class="ugc-stat">
                <span class="num">100%</span>
                <span class="lbl">Vedação Antivazamento</span>
              </div>
              <div class="ugc-stat">
                <span class="num">11</span>
                <span class="lbl">Cores Disponíveis</span>
              </div>
            </div>

            <div class="ugc-cta-box">
              <a
                href={product.affiliateUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary-glow font-mono js-affiliate-track"
              >
                QUERO MINHA GARRAFA NO TIKTOK ↗
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Reviews & Social Proof Section -->
      <section class="pdp-reviews-section" aria-labelledby="reviews-title">
        <div class="section-title-wrap">
          <span class="section-tag font-mono">AVALIAÇÕES REAIS</span>
          <h2 id="reviews-title" class="font-display">O Que Dizem os Compradores</h2>
          <p class="section-sub font-mono">Avaliação média de 4.8 / 5.0 estrelas no TikTok Shop</p>
        </div>

        <div class="reviews-grid">
          <article class="review-card">
            <div class="review-header">
              <div class="reviewer-info">
                <strong>Camila R.</strong>
                <span class="verified-buyer font-mono">✓ Compra Verificada</span>
              </div>
              <div class="review-stars">★★★★★</div>
            </div>
            <p class="review-body">
              "A garrafa é simplesmente perfeita! O brilho dela na luz é lindo demais, não solta glitter na mão e a água fica gelada o dia inteiro. A base de silicone protege muito."
            </p>
            <span class="review-date font-mono">Cor: Pink • 600ml</span>
          </article>

          <article class="review-card">
            <div class="review-header">
              <div class="reviewer-info">
                <strong>Mariana S.</strong>
                <span class="verified-buyer font-mono">✓ Compra Verificada</span>
              </div>
              <div class="review-stars">★★★★★</div>
            </div>
            <p class="review-body">
              "Vi o vídeo da Paulinha e decidi comprar. Chegou em 3 dias aqui em SP, bem embalada. A tampa veda de verdade, já joguei dentro da mochila de qualquer jeito e zero vazamento."
            </p>
            <span class="review-date font-mono">Cor: Rose Titanium • 800ml</span>
          </article>

          <article class="review-card">
            <div class="review-header">
              <div class="reviewer-info">
                <strong>Juliana F.</strong>
                <span class="verified-buyer font-mono">✓ Compra Verificada</span>
              </div>
              <div class="review-stars">★★★★★</div>
            </div>
            <p class="review-body">
              "Muito resistente! A alça ajuda bastante na academia e a cor verde esmeralda é maravilhosa. Super vale a pena pelo preço promocional."
            </p>
            <span class="review-date font-mono">Cor: Verde Esmeralda • 600ml</span>
          </article>
        </div>
      </section>

      <!-- Transparency & Affiliate Disclaimer -->
      <footer class="pdp-disclaimer-box" aria-label="Aviso de transparência comercial">
        <p class="disclaimer-title font-mono">⚖️ TRANSPARÊNCIA & CONFORMIDADE COMERCIAL</p>
        <p class="disclaimer-text">
          Esta página é uma vitrine de afiliados da creator <strong>Paulinha</strong> (@paulinhaazevedomendes), parte do ecossistema <strong>neøflow // Official TikTok Partners</strong>. O processamento de pagamentos, cobrança, emissão de nota fiscal e entrega dos produtos são realizados integralmente pelo <strong>TikTok Shop</strong> e pelo lojista homologado <strong>{product.seller}</strong>. A compra pelo link promocional gera uma comissão de afiliado sem custo adicional para o comprador. Paulinha é uma creator/personagem gerada por inteligência artificial com curadoria e direção criativa humana.
        </p>
      </footer>
    </div>

    <!-- Floating Sticky Bottom Bar (Mobile Conversion Anchor) -->
    <div class="mobile-sticky-buybar" id="sticky-buy-bar" aria-label="Barra de compra rápida">
      <div class="sticky-product-info">
        <span class="sticky-price font-mono">R$ {product.price}</span>
        <span class="sticky-desc">Garrafa Térmica Brilhante</span>
      </div>
      <a
        href={product.affiliateUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="sticky-cta-btn js-affiliate-track"
      >
        <span>COMPRAR NO TIKTOK</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298 0 .594.044.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.49 6.27 6.27 0 0 0 1.89-4.49V8.75a8.28 8.28 0 0 0 4.88 1.57V6.87c-.33-.04-.67-.1-1-.18z"/>
        </svg>
      </a>
    </div>
  </main>

  <script is:inline>
    // Gallery Thumbnail Switching
    document.addEventListener('DOMContentLoaded', () => {
      const mainImg = document.getElementById('main-product-image');
      const thumbBtns = document.querySelectorAll('.thumb-btn');

      thumbBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          thumbBtns.forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');

          const newSrc = btn.getAttribute('data-src');
          const newAlt = btn.getAttribute('data-alt');
          if (mainImg && newSrc) {
            mainImg.src = newSrc;
            if (newAlt) mainImg.alt = newAlt;
          }
        });
      });

      // Color Chip Selection
      const colorChips = document.querySelectorAll('.color-chip');
      const selectedColorLabel = document.getElementById('selected-color-name');

      colorChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          colorChips.forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');
          const colorName = chip.getAttribute('data-color-name');
          if (selectedColorLabel && colorName) {
            selectedColorLabel.textContent = colorName;
          }
        });
      });

      // Capacity Pill Selection
      const capPills = document.querySelectorAll('.cap-pill');
      const selectedCapLabel = document.getElementById('selected-capacity');

      capPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          capPills.forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');
          const cap = pill.getAttribute('data-capacity');
          if (selectedCapLabel && cap) {
            selectedCapLabel.textContent = cap;
          }
        });
      });

      // TikTok Pixel & Custom Event Analytics on Affiliate Clicks
      const affiliateLinks = document.querySelectorAll('.js-affiliate-track');
      affiliateLinks.forEach((link) => {
        link.addEventListener('click', () => {
          if (window.ttq && typeof window.ttq.track === 'function') {
            window.ttq.track('InitiateCheckout', {
              content_name: 'Garrafa Termica Brilhante Base Silicone',
              content_id: 'garrafa-termica-brilhante',
              content_type: 'product',
              value: 42.90,
              currency: 'BRL'
            });
          }
        });
      });
    });
  </script>
</BaseLayout>

<style>
  /* Base Layout & Color Variables */
  .product-page {
    position: relative;
    padding-top: calc(80px + var(--sat));
    padding-bottom: 120px;
    min-height: 100vh;
    background: radial-gradient(circle at 50% 0%, rgba(254, 44, 85, 0.08) 0%, transparent 60%),
                radial-gradient(circle at 100% 40%, rgba(0, 242, 254, 0.05) 0%, transparent 50%),
                var(--neo-bg);
  }

  .product-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 450px;
    background: radial-gradient(ellipse at top, rgba(233, 30, 99, 0.12) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .product-container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Breadcrumbs */
  .pdp-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    margin-bottom: 16px;
    color: var(--neo-text-muted);
  }

  .crumb-link {
    color: var(--neo-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .crumb-link:hover {
    color: var(--neo-cyan);
  }

  .crumb-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .crumb-current {
    color: var(--neo-white);
    font-weight: 500;
  }

  /* Creator Endorsement Bar */
  .creator-badge-bar {
    display: flex;
    align-items: center;
