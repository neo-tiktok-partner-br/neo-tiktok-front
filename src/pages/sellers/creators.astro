---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pillars = [
  {
    code: '01',
    title: 'CIRCULAÇÃO NATIVA DE PRODUTO',
    copy: 'Seus produtos não dependem de anúncios frios para serem descobertos. Eles ganham tração e contexto orgânico nas mãos de criadores que já dominam a linguagem da plataforma.',
  },
  {
    code: '02',
    title: 'OPORTUNIDADES E AFILIAÇÃO',
    copy: 'Estruture condições claras para que creators qualificados coloquem sua marca em vídeos e lives, conectando o catálogo diretamente a conteúdos com potencial de escala.',
  },
  {
    code: '03',
    title: 'OPERAÇÃO CONECTADA',
    copy: 'Conteúdo e comércio operando juntos. O público descobre o produto no feed e conclui o pedido sem ser empurrado para jornadas externas e cheias de atrito.',
  },
] as const;
---

<BaseLayout
  title="Creators para Sellers // neøflow Official TikTok Partners"
  description="Creators como distribuição. Prepare seus produtos e oportunidades para trabalhar com creators no TikTok Shop."
>
  <main class="seller-sub-page">
    <div class="ambient-glow" aria-hidden="true"></div>

    <div class="seller-sub-container">
      <nav class="sub-nav" aria-label="Navegação de retorno">
        <a class="nav-back font-mono" href="/sellers">← VOLTAR PARA SELLERS</a>
      </nav>

      <!-- Hero Header -->
      <header class="sub-hero">
        <div class="kicker-pill font-mono">
          <span class="coral-dot" aria-hidden="true"></span>
          01.1 // SHOP // CREATORS
        </div>
        <h1 class="font-display">Creators como distribuição.</h1>
        <p class="sub-lead">
          Coloque seus produtos em circulação por meio de conteúdo e colaboração. Prepare seu inventário para trabalhar com quem já tem atenção e audiência no TikTok.
        </p>

        <div class="hero-actions-box">
          <div class="cta-primary-wrap">
            <a class="cta-primary font-mono" href="/sellers/conectar">
              <span>CONECTAR MINHA LOJA</span>
              <span class="cta-arrow" aria-hidden="true">→</span>
            </a>
            <span class="cta-microcopy">Autorização feita pelo TikTok Shop.</span>
          </div>
        </div>
      </header>

      <!-- Pilares Comerciais -->
      <section class="pillars-section" aria-labelledby="pillars-title">
        <div class="section-label font-mono">01 // COMO FUNCIONA</div>
        <h2 id="pillars-title" class="sr-only">Pilares da distribuição com creators</h2>

        <div class="pillars-list">
          {pillars.map((item) => (
            <article class="pillar-card">
              <div class="pillar-header font-mono">
                <span class="pillar-num">{item.code}</span>
                <h3 class="pillar-title">{item.title}</h3>
              </div>
              <p class="pillar-copy">{item.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Bottom Box -->
      <section class="bottom-action-card">
        <span class="bottom-kicker font-mono">PRÓXIMO PASSO</span>
        <h2 class="font-display">Conecte sua loja e ative a distribuição.</h2>
        <p>
          O primeiro passo é autorizar sua loja para habilitar a aproximação dos seus produtos com o ecossistema de criadores.
        </p>
        <div class="bottom-cta-wrap">
          <a class="cta-primary font-mono" href="/sellers/conectar">
            <span>CONECTAR MINHA LOJA</span>
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
          <span class="cta-microcopy">Autorização feita pelo TikTok Shop.</span>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .seller-sub-page {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    padding: calc(6.5rem + var(--sat, 0px)) 1.25rem 5rem;
    display: flex;
    justify-content: center;
    background: #070809;
    color: #ffffff;
  }

  .ambient-glow {
    position: absolute;
    top: 12%;
    left: 50%;
    transform: translateX(-50%);
    width: min(800px, 90vw);
    height: 460px;
    background: radial-gradient(circle, rgba(254, 44, 85, 0.13) 0%, rgba(7, 8, 9, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  .seller-sub-container {
    width: 100%;
    max-width: 740px;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .sub-nav {
    display: flex;
    align-items: center;
  }

  .nav-back {
    font-size: 0.78rem;
    color: var(--neo-dim, #94a3b8);
    text-decoration: none;
    letter-spacing: 0.08em;
    transition: color 0.18s ease;
  }

  .nav-back:hover {
    color: var(--neo-coral, #fe2c55);
  }

  .sub-hero {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .kicker-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(254, 44, 85, 0.08);
    border: 1px solid rgba(254, 44, 85, 0.25);
    color: var(--neo-coral, #fe2c55);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .coral-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--neo-coral, #fe2c55);
    box-shadow: 0 0 8px var(--neo-coral, #fe2c55);
  }

  .sub-hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .sub-lead {
    font-size: clamp(1.05rem, 3vw, 1.2rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    margin: 0;
  }

  .hero-actions-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .cta-primary-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 50px;
    padding: 0.95rem 1.75rem;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--neo-coral, #fe2c55) 0%, #d81640 100%);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    box-shadow: 0 10px 28px -4px rgba(254, 44, 85, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -4px rgba(254, 44, 85, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    filter: brightness(1.06);
  }

  .cta-primary:active {
    transform: scale(0.98);
  }

  .cta-arrow {
    transition: transform 0.18s ease;
  }

  .cta-primary:hover .cta-arrow {
    transform: translateX(3px);
  }

  .cta-microcopy {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.48);
    letter-spacing: 0.02em;
    padding-left: 0.25rem;
  }

  .pillars-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--neo-coral, #fe2c55);
    letter-spacing: 0.14em;
  }

  .pillars-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem;
    border-radius: 18px;
    background: rgba(18, 20, 24, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .pillar-card:hover {
    border-color: rgba(254, 44, 85, 0.3);
    transform: translateY(-2px);
  }

  .pillar-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .pillar-num {
    color: var(--neo-coral, #fe2c55);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .pillar-title {
    margin: 0;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .pillar-copy {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .bottom-action-card {
    border-radius: 22px;
    background: linear-gradient(145deg, rgba(28, 14, 19, 0.88) 0%, rgba(14, 16, 19, 0.95) 100%);
    border: 1px solid rgba(254, 44, 85, 0.28);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 20px 48px -8px rgba(0, 0, 0, 0.7);
  }

  .bottom-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--neo-coral, #fe2c55);
    letter-spacing: 0.14em;
  }

  .bottom-action-card h2 {
    font-size: clamp(1.4rem, 3.8vw, 1.85rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }

  .bottom-action-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .bottom-cta-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.5rem;
    align-self: flex-start;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .seller-sub-container {
      gap: 2.5rem;
    }
    .bottom-action-card {
      padding: 1.5rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-primary, .pillar-card, .nav-back, .cta-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
