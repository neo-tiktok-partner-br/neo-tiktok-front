---
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = [
  {
    code: '01',
    label: 'Shop',
    title: 'Quero vender no TikTok Shop.',
    description: 'Conheça a infraestrutura para sellers, marcas e operações de comércio.',
    href: '/shop',
    accent: 'var(--neo-coral)',
  },
  {
    code: '02',
    label: 'Creators',
    title: 'Quero criar e monetizar conteúdo.',
    description: 'Explore oportunidades, curadoria de produtos e colaboração para creators.',
    href: '/creators',
    accent: 'var(--neo-cyan)',
  },
  {
    code: '03',
    label: 'Agências',
    title: 'Quero acelerar marcas e operações.',
    description: 'A frente para agências parceiras, coprodução, marketing de performance e escala.',
    href: '/marketing',
    accent: 'var(--neo-white)',
  },
  {
    code: '04',
    label: 'Tech',
    title: 'Quero operar ou integrar tecnologia.',
    description: 'Acesse a infraestrutura para desenvolvedores, contratos de API e automações.',
    href: '/tech',
    accent: 'var(--neo-acid)',
  },
];
---

<BaseLayout
  title="neøflow // Shop, Creators, Agências e Tech"
  description="Entrada pública da neøflow para Shop, Creators, Agências e Tech no ecossistema TikTok."
>
  <section class="launch-entry" aria-labelledby="launch-title">
    <div class="launch-glow" aria-hidden="true"></div>
    <div class="launch-container">
      <header class="launch-header">
        <img
          src="/assets/logo_partners.svg"
          alt="neøflow Official TikTok Partners"
          class="launch-logo"
          width="860"
          height="260"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <p class="launch-kicker font-mono">ENTRADA PÚBLICA · NAVEGAÇÃO WEB</p>
        <h1 id="launch-title" class="font-display">Escolha o que você veio fazer.</h1>
        <p class="launch-subtitle">
          Explore sem criar conta. A autenticação aparece somente quando um recurso realmente precisar dela.
        </p>
      </header>

      <nav class="launch-grid" aria-label="Escolha sua entrada">
        {entries.map((entry) => (
          <a class="launch-card" href={entry.href} style={`--entry-accent: ${entry.accent}`}>
            <span class="launch-card-meta font-mono">
              <span>{entry.code}</span>
              <span>{entry.label}</span>
            </span>
            <span class="launch-card-title font-display">{entry.title}</span>
            <span class="launch-card-description">{entry.description}</span>
            <span class="launch-card-action font-mono" aria-hidden="true">CONTINUAR →</span>
          </a>
        ))}
      </nav>

      <p class="launch-note font-mono">
        Você permanece em neotiktok.com até escolher um recurso que exija autorização.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .launch-entry {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: clip;
    padding:
      calc(7rem + var(--sat))
      calc(1rem + var(--sar))
      calc(3rem + var(--sab))
      calc(1rem + var(--sal));
  }

  .launch-glow {
    position: absolute;
    top: -14rem;
    left: 50%;
    width: min(48rem, 100%);
    height: 34rem;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(215, 254, 9, 0.11), rgba(0, 242, 254, 0.05) 38%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  .launch-container {
    position: relative;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
  }

  .launch-header {
    max-width: 760px;
  }

  .launch-logo {
    display: block;
    width: min(100%, 430px);
    height: auto;
    margin-bottom: clamp(2.5rem, 8vh, 5rem);
  }

  .launch-kicker {
    color: var(--neo-acid);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .launch-header h1 {
    margin: 0.85rem 0 1rem;
    font-size: clamp(2.6rem, 10vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.065em;
    overflow-wrap: anywhere;
  }

  .launch-subtitle {
    max-width: 620px;
    color: var(--neo-text-muted);
    font-size: clamp(1rem, 3vw, 1.2rem);
  }

  .launch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.85rem;
    margin-top: clamp(2.5rem, 7vh, 4.5rem);
  }

  .launch-card {
    min-width: 0;
    min-height: 250px;
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--neo-border);
    border-radius: var(--radius-ios);
    background: var(--neo-bg-card);
    color: var(--neo-white);
    text-decoration: none;
    box-shadow: var(--shadow-ios);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .launch-card:hover,
  .launch-card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--entry-accent);
    outline: none;
  }

  .launch-card-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--entry-accent);
    font-size: 0.68rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .launch-card-title {
    margin-top: auto;
    padding-top: 2rem;
    font-size: clamp(1.45rem, 4vw, 2.1rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .launch-card-description {
    margin: 0.85rem 0 1.25rem;
    color: var(--neo-text-muted);
    font-size: 0.9rem;
  }

  .launch-card-action {
    padding-top: 0.9rem;
    border-top: 1px solid var(--neo-border);
    color: var(--entry-accent);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .launch-note {
    margin-top: 1.5rem;
    color: var(--neo-text-muted);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .launch-grid {
      grid-template-columns: 1fr;
    }

    .launch-card {
      min-height: 210px;
    }
  }

  @media (max-width: 360px) {
    .launch-entry {
      padding-right: calc(0.75rem + var(--sar));
      padding-left: calc(0.75rem + var(--sal));
    }

    .launch-card {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .launch-card {
      transition: none;
    }

    .launch-card:hover,
    .launch-card:focus-visible {
      transform: none;
    }
  }
</style>
