---
import MiniLayout from '../layouts/MiniLayout.astro';
---

<MiniLayout title="neøflow // TikTok Minis In-App Platform" role="common">
  <div class="minis-hub-view">
    <div class="hub-header">
      <span class="hub-badge font-mono">TIKTOK MINIS IN-APP PLATFORM</span>
      <h1 class="font-display">Escolha sua porta de entrada</h1>
      <p class="hub-subtitle">
        Operação 100% nativa dentro do TikTok. Sem atrito, sem redirecionamento para fora do app.
      </p>
    </div>

    <div class="hub-cards-stack">
      <!-- Seller Mini App -->
      <a href="/minis/seller" class="hub-entry-card seller-card">
        <div class="card-icon font-mono">📦</div>
        <div class="card-body">
          <span class="card-kicker font-mono">PARA LOJISTAS</span>
          <h2>Seller Engine</h2>
          <p>Conecte seu estoque, sincronize catálogo e acione checkout nativo em 1 clique.</p>
        </div>
        <div class="card-arrow font-mono">→</div>
      </a>

      <!-- Creator Mini Hub -->
      <a href="/minis/creator" class="hub-entry-card creator-card">
        <div class="card-icon font-mono">🎧</div>
        <div class="card-body">
          <span class="card-kicker font-mono">PARA CRIADORES</span>
          <h2>Creator Hub</h2>
          <p>Produtos qualificados pelo NΞØ Gatekeeper, links de DM e comissão instantânea.</p>
        </div>
        <div class="card-arrow font-mono">→</div>
      </a>

      <!-- Series Microlearning -->
      <a href="/minis/series" class="hub-entry-card series-card">
        <div class="card-icon font-mono">⚡</div>
        <div class="card-body">
          <span class="card-kicker font-mono">MICROLEARNING 2026</span>
          <h2>TikTok Series 24/7</h2>
          <p>Micro-vídeos atômicos, conversão perpétua e checkout nativo no app.</p>
        </div>
        <div class="card-arrow font-mono">→</div>
      </a>

      <!-- Agency / Tech Partner -->
      <a href="/shop" class="hub-entry-card agency-card">
        <div class="card-icon font-mono">🏢</div>
        <div class="card-body">
          <span class="card-kicker font-mono">AGÊNCIAS &amp; TECH</span>
          <h2>Infraestrutura de Rede</h2>
          <p>Operações assistidas, APIs abertas, webhooks e ecossistema de parceiros.</p>
        </div>
        <div class="card-arrow font-mono">→</div>
      </a>
    </div>

    <div class="hub-footer-stamp font-mono">
      <span>🔒 TikTok Partner Verificado · neøflow</span>
      <a href="/home" class="desktop-link">Visualizar Versão Desktop Clássica →</a>
    </div>
  </div>
</MiniLayout>

<style>
  .minis-hub-view {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hub-header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .hub-badge {
    color: var(--neo-coral);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .hub-header h1 {
    font-size: 1.75rem;
    line-height: 1.1;
    color: #ffffff;
    margin: 0;
  }

  .hub-subtitle {
    color: var(--neo-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  .hub-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hub-entry-card {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid var(--neo-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .hub-entry-card:hover {
    transform: translateY(-2px);
  }

  .seller-card:hover {
    border-color: var(--neo-coral);
  }

  .creator-card:hover {
    border-color: var(--neo-cyan);
  }

  .series-card:hover {
    border-color: var(--neo-acid);
  }

  .agency-card:hover {
    border-color: var(--neo-white);
  }

  .agency-card .card-kicker { color: var(--neo-text-muted); }

  .card-icon {
    font-size: 1.75rem;
    background: rgba(255, 255, 255, 0.05);
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .card-kicker {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--neo-text-muted);
  }

  .seller-card .card-kicker { color: var(--neo-coral); }
  .creator-card .card-kicker { color: var(--neo-cyan); }
  .series-card .card-kicker { color: var(--neo-acid); }

  .card-body h2 {
    font-size: 1.15rem;
    color: #ffffff;
    margin: 0;
  }

  .card-body p {
    font-size: 0.78rem;
    color: var(--neo-text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .card-arrow {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .hub-footer-stamp {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    font-size: 0.6875rem;
    color: var(--neo-text-muted);
    padding-top: 1rem;
  }

  .desktop-link {
    color: var(--neo-cyan);
    text-decoration: none;
    font-size: 0.625rem;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  .desktop-link:hover {
    opacity: 1;
    text-decoration: underline;
  }
</style>
