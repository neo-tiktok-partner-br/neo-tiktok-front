---
import MiniLayout from '../../../layouts/MiniLayout.astro';
---

<MiniLayout title="Painel Lojista // neøflow Minis" role="seller" activeTab="orders">
  <div class="seller-dash-view">
    <!-- Status Header -->
    <div class="sync-status-box font-mono">
      <span class="live-dot"></span>
      <span>CATÁLOGO SINCRONIZADO (84 PRODUTOS)</span>
    </div>

    <!-- Main Metric Cards -->
    <div class="metrics-grid">
      <div class="metric-card">
        <span class="metric-label font-mono">VENDAS HOJE (DM + FEED)</span>
        <div class="metric-val font-display">R$ 14.820,00</div>
        <span class="metric-sub font-mono">↑ +24.6% vs ontem</span>
      </div>

      <div class="metric-card">
        <span class="metric-label font-mono">CONVERSÃO 1-CLIQUE</span>
        <div class="metric-val font-display" style="color: var(--neo-cyan);">14.2%</div>
        <span class="metric-sub font-mono">Checkout nativo TikTok</span>
      </div>
    </div>

    <!-- Active Creators Mini Section -->
    <div class="dash-section">
      <div class="section-title-row">
        <span class="sec-kicker font-mono">CRIADORES ATIVOS</span>
        <span class="sec-badge font-mono">18 Conectados</span>
      </div>

      <div class="creator-mini-list">
        <div class="creator-mini-item">
          <div class="creator-avatar">👩‍🎤</div>
          <div class="creator-info">
            <strong>@paulinha.trend</strong>
            <span>42 vendas hoje · R$ 3.780,00</span>
          </div>
          <span class="creator-tag font-mono">LIVE</span>
        </div>

        <div class="creator-mini-item">
          <div class="creator-avatar">👨‍💻</div>
          <div class="creator-info">
            <strong>@tech.review.br</strong>
            <span>28 vendas hoje · R$ 2.450,00</span>
          </div>
          <span class="creator-tag font-mono">DM AUTO</span>
        </div>
      </div>
    </div>

    <!-- Fast Actions -->
    <div class="quick-actions-box">
      <a href="/app/orders" class="btn-action font-mono">
        📦 Ver Pedidos Detalhados
      </a>
      <a href="https://wa.me/5562981358000" class="btn-action secondary font-mono" target="_blank" rel="noopener">
        💬 Falar com Account Manager
      </a>
    </div>
  </div>
</MiniLayout>

<style>
  .seller-dash-view {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sync-status-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(74, 222, 128, 0.1);
    border: 1px solid rgba(74, 222, 128, 0.25);
    color: #4ade80;
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-full);
    align-self: flex-start;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #4ade80;
    box-shadow: 0 0 6px #4ade80;
  }

  .metrics-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .metric-card {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid var(--neo-border);
    border-radius: var(--radius-md);
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .metric-label {
    font-size: 0.625rem;
    color: var(--neo-text-muted);
    letter-spacing: 0.08em;
  }

  .metric-val {
    font-size: 1.65rem;
    color: #ffffff;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .metric-sub {
    font-size: 0.6875rem;
    color: #4ade80;
  }

  .dash-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sec-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--neo-coral);
    letter-spacing: 0.08em;
  }

  .sec-badge {
    font-size: 0.625rem;
    color: var(--neo-text-muted);
  }

  .creator-mini-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .creator-mini-item {
    background: rgba(18, 18, 20, 0.65);
    border: 1px solid var(--neo-border);
    border-radius: 12px;
    padding: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .creator-avatar {
    font-size: 1.4rem;
  }

  .creator-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
  }

  .creator-info strong {
    font-size: 0.82rem;
    color: #ffffff;
  }

  .creator-info span {
    font-size: 0.7rem;
    color: var(--neo-text-muted);
  }

  .creator-tag {
    font-size: 0.58rem;
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
    background: rgba(254, 44, 85, 0.15);
    color: var(--neo-coral);
    border: 1px solid rgba(254, 44, 85, 0.3);
  }

  .quick-actions-box {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .btn-action {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--neo-border);
    color: #ffffff;
    padding: 0.85rem;
    border-radius: 12px;
    font-size: 0.78rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .btn-action:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .btn-action.secondary {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.3);
  }
</style>
