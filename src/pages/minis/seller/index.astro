---
import MiniLayout from '../../../layouts/MiniLayout.astro';
---

<MiniLayout title="Seller Engine // neøflow Minis" role="seller" activeTab="home">
  <div class="seller-splash-view">
    <!-- Header -->
    <div class="splash-badge font-mono">NEØFLOW MINIS // SELLER ENGINE</div>
    
    <div class="splash-hero">
      <h1 class="font-display">Pluge seu estoque na máquina de escala do TikTok.</h1>
      <p class="splash-lead">
        Sincronização invisível de catálogo, conexão com criadores calibrados e checkout nativo em 1 clique.
      </p>
    </div>

    <!-- Highlights Stack -->
    <div class="highlights-stack">
      <div class="highlight-item">
        <span class="highlight-dot font-mono">⚡</span>
        <div>
          <strong>Checkout Nativo em 1 Clique</strong>
          <p>Compre por vídeo, live ou DM via FaceID/Pix sem sair do app.</p>
        </div>
      </div>

      <div class="highlight-item">
        <span class="highlight-dot font-mono">🔄</span>
        <div>
          <strong>Sincronização Invisível de Catálogo</strong>
          <p>Estoque e preços atualizados no piloto automático via API oficial.</p>
        </div>
      </div>

      <div class="highlight-item">
        <span class="highlight-dot font-mono">💸</span>
        <div>
          <strong>Split de Pagamento 100% Automático</strong>
          <p>Liquidação financeira instantânea sem cálculo ou transferência manual.</p>
        </div>
      </div>
    </div>

    <!-- Primary Action -->
    <div class="action-box">
      <a href="/sellers/conectar" class="btn-minis-primary font-mono">
        AUTORIZAR E PLUGAR CATÁLOGO →
      </a>
      <a href="/minis/seller/dashboard" class="btn-minis-secondary font-mono">
        ACESSAR PAINEL OPERACIONAL
      </a>
      <span class="security-note font-mono">
        🔒 Conexão Criptografada Oficial · Parceria TikTok Shop Brasil
      </span>
    </div>
  </div>
</MiniLayout>

<style>
  .seller-splash-view {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .splash-badge {
    color: var(--neo-coral);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .splash-hero h1 {
    font-size: 1.65rem;
    line-height: 1.15;
    color: #ffffff;
    margin: 0 0 0.5rem;
  }

  .splash-lead {
    color: var(--neo-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  .highlights-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: rgba(18, 18, 20, 0.75);
    border: 1px solid var(--neo-border);
    border-radius: var(--radius-md);
    padding: 1.15rem;
  }

  .highlight-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .highlight-dot {
    font-size: 1.1rem;
    line-height: 1;
    margin-top: 0.1rem;
  }

  .highlight-item strong {
    font-size: 0.85rem;
    color: #ffffff;
    display: block;
    margin-bottom: 0.15rem;
  }

  .highlight-item p {
    font-size: 0.75rem;
    color: var(--neo-text-muted);
    margin: 0;
    line-height: 1.35;
  }

  .action-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn-minis-primary {
    background: var(--neo-coral);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 1rem;
    border-radius: 12px;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(254, 44, 85, 0.35);
  }

  .btn-minis-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--neo-border);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.8rem;
    padding: 0.85rem;
    border-radius: 12px;
    text-align: center;
    text-decoration: none;
  }

  .security-note {
    font-size: 0.65rem;
    color: var(--neo-text-muted);
    text-align: center;
  }
</style>
